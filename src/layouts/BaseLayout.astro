---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/reset.css';
import '../styles/global.css';
import '../styles/utilities.css';
import '../styles/backgrounds.css';
import '../styles/components/typography.css';
import '../styles/components/layout.css';
import '../styles/components/navigation.css';
import '../styles/components/buttons.css';
import '../styles/components/cards.css';
import '../styles/components/forms.css';
import '../styles/components/content.css';
import '../styles/components/home-hero.css';
import '../styles/components/home-story.css';
import '../styles/components/mission-globe.css';
import '../styles/components/showcase.css';
import '../styles/components/particle-morph.css';
import '../styles/components/methodology-flow.css';
import '../styles/motion.css';

const { title = 'E Deviser', description = 'E Deviser combines AI, data, and domain intelligence to solve complex problems.', lang = 'en', dir = 'ltr', noindex = false } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const fullTitle = title.includes('E Deviser') ? title : `${title} | E Deviser`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09121D" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="E Deviser" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
