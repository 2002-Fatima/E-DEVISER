---
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import '../styles/utilities.css';
import '../styles/backgrounds.css';
import '../styles/components.css';
import '../styles/motion.css';

const { title = 'E Deviser', description = 'E Deviser combines AI, data, and domain intelligence to solve complex problems.' } = Astro.props;
const fullTitle = title.includes('E Deviser') ? title : `${title} | E Deviser`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0382BD" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
