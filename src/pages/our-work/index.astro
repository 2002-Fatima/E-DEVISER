---
import MainLayout from '../../layouts/MainLayout.astro';
import OurWorkHero from '../../components/our-work/OurWorkHero.astro';
import SectionNavigation from '../../components/layout/SectionNavigation.astro';
import InitiativesVolume from '../../components/our-work/InitiativesVolume.astro';
import PartnershipsVolume from '../../components/our-work/PartnershipsVolume.astro';
import ForumsEventsSection from '../../components/our-work/ForumsEventsSection.astro';
import InTheFieldSection from '../../components/our-work/InTheFieldSection.astro';
import StoriesSection from '../../components/our-work/StoriesSection.astro';
import RecognitionSection from '../../components/our-work/RecognitionSection.astro';
import ArchiveSection from '../../components/our-work/ArchiveSection.astro';
import WorkClosingSection from '../../components/our-work/WorkClosingSection.astro';

const navItems = [
  { label: 'Initiatives', href: '#initiatives' },
  { label: 'Partnerships', href: '#partnerships' },
  { label: 'Forums & Events', href: '#forums-events' },
  { label: 'In the Field', href: '#in-the-field' },
  { label: 'Explore', href: '#stories' },
  { label: 'Recognition', href: '#recognition' },
  { label: 'Archive', href: '#archive' },
];
const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Our Work' }];
---

<MainLayout title="Our Work" description="A closer look at E Deviser's initiatives, partnerships, forums, field work, stories, and recognition." breadcrumbs={breadcrumbs}>
  <OurWorkHero />
  <SectionNavigation items={navItems} />
  <InitiativesVolume />
  <PartnershipsVolume />
  <ForumsEventsSection />
  <InTheFieldSection />
  <StoriesSection />
  <RecognitionSection />
  <ArchiveSection />
  <WorkClosingSection />
</MainLayout>
