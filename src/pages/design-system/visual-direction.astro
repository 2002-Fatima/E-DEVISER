---
import MainLayout from '../../layouts/MainLayout.astro';
import Container from '../../components/ui/Container.astro';
import HeroTransformation from '../../components/ui/HeroTransformation.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Design System', href: '/design-system/' },
  { label: 'Visual Direction' },
];
---

<MainLayout
  title="Visual Direction Prototype"
  description="Focused E Deviser prototype for dark atmospheric surfaces and particle-based morphic typography."
  breadcrumbs={breadcrumbs}
>
  <div class="visual-direction-page">
    <section class="section-wrapper background-atmosphere">
      <Container width="standard">
        <p class="eyebrow">E DEVISER / VISUAL DIRECTION</p>
        <h1 class="type-h1">
          Intelligence adapts to <span class="text-gradient">complexity.</span>
        </h1>
        <p class="type-body-large">
          Deep navy surfaces, restrained brand light, and purposeful motion share one visual language.
        </p>
      </Container>
    </section>

    <section class="section-wrapper background-base">
      <Container width="wide">
        <HeroTransformation />
      </Container>
    </section>

    <section class="section-wrapper background-luminous">
      <Container width="standard">
        <p class="eyebrow">VISUAL SYSTEM / SURFACE CONTRAST</p>
        <h2 class="type-h2">Atmosphere supports the message, never competes with it.</h2>
        <p class="type-body-large">
          Blue and teal light stays close to the content that needs emphasis. Solid dark surfaces
          preserve contrast and keep the system readable without decorative waves.
        </p>
        <a class="text-link" href="/design-system/">Return to the design system</a>
      </Container>
    </section>
  </div>
</MainLayout>
