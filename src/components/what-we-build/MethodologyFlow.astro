---
import { methodologySteps } from '../../content/methodology';

const flowSteps = methodologySteps.map((step, index) => ({
  ...step,
  title: index === 0 ? 'The Problem' : step.title,
}));
---

<div class="methodology-flow" data-methodology-flow data-active-index="0">
  <div class="methodology-cosmos" aria-hidden="true">
    <svg class="methodology-cosmos-svg" viewBox="0 0 1440 420" preserveAspectRatio="none" focusable="false">
      <defs>
        <linearGradient id="methodology-ribbon" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="var(--brand-blue)" stop-opacity="0.04" />
          <stop offset=".24" stop-color="var(--brand-blue-light)" stop-opacity=".72" />
          <stop offset=".55" stop-color="var(--brand-teal-light)" />
          <stop offset="1" stop-color="var(--brand-teal)" stop-opacity=".78" />
        </linearGradient>
        <radialGradient id="methodology-aura">
          <stop offset="0" stop-color="var(--brand-white)" />
          <stop offset=".16" stop-color="var(--brand-teal-light)" stop-opacity=".92" />
          <stop offset=".46" stop-color="var(--brand-blue)" stop-opacity=".28" />
          <stop offset="1" stop-color="var(--brand-blue)" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="methodology-thread" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--brand-blue-light)" stop-opacity="0" />
          <stop offset=".5" stop-color="var(--brand-teal-light)" />
          <stop offset="1" stop-color="var(--brand-blue-light)" stop-opacity="0" />
        </linearGradient>
        <filter id="methodology-bloom" x="-200%" y="-200%" width="500%" height="500%">
          <feGaussianBlur stdDeviation="9" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <filter id="methodology-soft-bloom" x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur stdDeviation="3.5" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <path id="methodology-river-path" d="M120 216 C190 216 260 146 360 178 S500 280 600 216 S740 122 840 190 S980 286 1080 216 S1220 140 1320 216" />
      </defs>

      <path class="methodology-river-shadow" d="M120 216 C190 216 260 146 360 178 S500 280 600 216 S740 122 840 190 S980 286 1080 216 S1220 140 1320 216" />
      <path class="methodology-river-line" d="M120 216 C190 216 260 146 360 178 S500 280 600 216 S740 122 840 190 S980 286 1080 216 S1220 140 1320 216" />
      <path class="methodology-river-highlight" d="M120 216 C190 216 260 146 360 178 S500 280 600 216 S740 122 840 190 S980 286 1080 216 S1220 140 1320 216" />

      <g class="methodology-constellation methodology-constellation--problem" transform="translate(120 216)">
        <circle class="methodology-aura" r="92" fill="url(#methodology-aura)" />
        <path class="problem-shard" d="M-58-18L-24-55L-5-24L-31 4Z" />
        <path class="problem-shard problem-shard--two" d="M8-64L42-48L31-12L-2-24Z" />
        <path class="problem-shard problem-shard--three" d="M-46 25L-12 6L9 43L-24 57Z" />
        <path class="problem-shard problem-shard--four" d="M28 12L62-8L69 27L43 49Z" />
        <path class="problem-shard problem-shard--five" d="M-7-3L15-31L34-1L11 24Z" />
        <path class="problem-thread" d="M-74-42Q-32-4-8-72T58-53M-67 45Q-14 8 9 66T73 13M-34-66Q-5-12 46 56" />
        <circle class="problem-grain" cx="-76" cy="-12" r="3" /><circle class="problem-grain" cx="78" cy="-42" r="2" />
        <circle class="problem-grain" cx="-62" cy="64" r="2.5" /><circle class="problem-grain" cx="53" cy="64" r="3" />
        <circle class="problem-grain" cx="2" cy="-81" r="2" /><circle class="problem-grain" cx="84" cy="18" r="1.8" />
      </g>

      <g class="methodology-constellation methodology-constellation--understand" transform="translate(360 178)">
        <circle class="methodology-aura" r="94" fill="url(#methodology-aura)" />
        <circle class="understand-contour understand-contour--one" r="67" />
        <circle class="understand-contour understand-contour--two" r="48" />
        <circle class="understand-contour understand-contour--three" r="28" />
        <path class="understand-lens" d="M-75 0C-38-61 38-61 75 0C38 61-38 61-75 0Z" />
        <path class="understand-axis" d="M-88 0H88M0-78V78" />
        <path class="understand-ray" d="M-54 49L0 0L42-57" />
        <circle class="understand-focus" r="8" />
        <circle class="understand-orbit-dot" cx="0" cy="-67" r="4" />
      </g>

      <g class="methodology-constellation methodology-constellation--design" transform="translate(600 216)">
        <circle class="methodology-aura" r="96" fill="url(#methodology-aura)" />
        <path class="design-shell" d="M0-77C42-77 78-43 78 0C78 43 42 77 0 77C-42 77-78 43-78 0C-78-43-42-77 0-77Z" />
        <path class="design-lattice" d="M0-77L26-26L78 0L26 26L0 77L-26 26L-78 0L-26-26Z M-26-26H26V26H-26Z M0-77V77 M-78 0H78" />
        <path class="design-inner" d="M0-39L34-20L34 20L0 39L-34 20L-34-20Z" />
        <circle class="design-anchor" cx="0" cy="-77" r="4" /><circle class="design-anchor" cx="78" cy="0" r="4" />
        <circle class="design-anchor" cx="0" cy="77" r="4" /><circle class="design-anchor" cx="-78" cy="0" r="4" />
        <circle class="design-core" r="7" />
      </g>

      <g class="methodology-constellation methodology-constellation--build" transform="translate(840 190)">
        <circle class="methodology-aura" r="98" fill="url(#methodology-aura)" />
        <path class="build-helix" d="M-65-53C-12-84 12 84 65 53M-65 53C-12 84 12-84 65-53" />
        <path class="build-circuit" d="M-65-53L-31-53L-12-31L12-31L31-53L65-53M-65 53L-31 53L-12 31L12 31L31 53L65 53M0-72V-31M0 31V72" />
        <path class="build-bridge" d="M-45 0H45M-24-20L0 0L24-20M-24 20L0 0L24 20" />
        <g class="build-nodes">
          <circle cx="-65" cy="-53" r="5" /><circle cx="65" cy="-53" r="5" />
          <circle cx="-65" cy="53" r="5" /><circle cx="65" cy="53" r="5" />
          <circle cx="0" cy="-72" r="4" /><circle cx="0" cy="72" r="4" /><circle r="8" />
        </g>
      </g>

      <g class="methodology-constellation methodology-constellation--solution" transform="translate(1080 216)">
        <circle class="methodology-aura" r="108" fill="url(#methodology-aura)" />
        <path class="solution-shell" d="M0-73C39-73 73-39 73 0C73 39 39 73 0 73C-39 73-73 39-73 0C-73-39-39-73 0-73Z" />
        <ellipse class="solution-orbit solution-orbit--one" rx="91" ry="31" />
        <ellipse class="solution-orbit solution-orbit--two" rx="91" ry="31" transform="rotate(60)" />
        <ellipse class="solution-orbit solution-orbit--three" rx="91" ry="31" transform="rotate(120)" />
        <circle class="solution-core-glow" r="54" fill="url(#methodology-aura)" filter="url(#methodology-bloom)" />
        <circle class="solution-core" r="18" />
        <circle class="solution-satellite" cx="0" cy="-91" r="5" />
      </g>

      <g class="methodology-constellation methodology-constellation--measure" transform="translate(1320 216)">
        <circle class="methodology-aura" r="100" fill="url(#methodology-aura)" />
        <circle class="measure-outer" r="78" />
        <circle class="measure-inner" r="56" />
        <circle class="measure-calibration" r="34" />
        <path class="measure-grid" d="M0-90V90M-90 0H90M-64-64L64 64M64-64L-64 64" />
        <path class="measure-signal" d="M-66 0H-36L-21-23L-7 34L12-46L28 0H66" />
        <path class="measure-sweep" d="M0-88V88" />
        <circle class="measure-point" cx="12" cy="-46" r="5" />
      </g>

      <g class="methodology-flow-dust">
        <circle cx="180" cy="72" r="2" /><circle cx="374" cy="332" r="1.5" />
        <circle cx="650" cy="66" r="2" /><circle cx="858" cy="346" r="1.7" />
        <circle cx="1166" cy="70" r="2" /><circle cx="1280" cy="334" r="1.5" />
      </g>
      <circle class="methodology-traveller methodology-traveller--one" r="5"><animateMotion dur="12s" repeatCount="indefinite"><mpath href="#methodology-river-path" /></animateMotion></circle>
      <circle class="methodology-traveller methodology-traveller--two" r="2.5"><animateMotion dur="12s" begin="-4s" repeatCount="indefinite"><mpath href="#methodology-river-path" /></animateMotion></circle>
      <circle class="methodology-traveller methodology-traveller--three" r="2"><animateMotion dur="12s" begin="-8s" repeatCount="indefinite"><mpath href="#methodology-river-path" /></animateMotion></circle>
    </svg>
  </div>

  <ol class="methodology-sequence" aria-label="Our six-stage methodology">
    {flowSteps.map((step, index) => (
      <li class="methodology-sequence-step" data-methodology-step data-index={index} data-description={step.description} aria-current={index === 0 ? 'step' : undefined}>
        <span class="methodology-sequence-number">{step.number}</span>
        <span class="methodology-sequence-title">{step.title}</span>
      </li>
    ))}
  </ol>

  <div class="methodology-transcript" data-methodology-transcript aria-live="polite" aria-atomic="true">
    <span class="methodology-transcript-index">01 <i>/</i> 06</span>
    <div class="methodology-transcript-content">
      <h3 data-methodology-title>{flowSteps[0].title}</h3>
      <p data-methodology-description>{flowSteps[0].description}</p>
    </div>
    <span class="methodology-transcript-signal" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-methodology-flow]').forEach((flow) => {
    if (flow.dataset.initialized === 'true') return;
    flow.dataset.initialized = 'true';

    const steps = Array.from(flow.querySelectorAll<HTMLElement>('[data-methodology-step]'));
    const title = flow.querySelector<HTMLElement>('[data-methodology-title]');
    const description = flow.querySelector<HTMLElement>('[data-methodology-description]');
    const index = flow.querySelector<HTMLElement>('.methodology-transcript-index');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const duration = 5200;
    let activeIndex = 0;
    let elapsed = 0;
    let startedAt = 0;
    let timer: number | undefined;
    let visible = true;
    let paused = false;

    const render = (nextIndex: number) => {
      activeIndex = nextIndex;
      flow.dataset.activeIndex = String(nextIndex);
      steps.forEach((step, stepIndex) => {
        if (stepIndex === nextIndex) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });

      const selected = steps[nextIndex];
      const nextTitle = selected?.querySelector('.methodology-sequence-title')?.textContent ?? '';
      const sourceDescription = selected?.getAttribute('data-description') ?? '';

      flow.classList.add('is-transitioning');
      window.setTimeout(() => {
        if (title) title.textContent = nextTitle;
        if (description) description.textContent = sourceDescription;
        if (index) index.textContent = `${String(nextIndex + 1).padStart(2, '0')} / 06`;
        flow.classList.remove('is-transitioning');
      }, 280);
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
      elapsed += startedAt ? performance.now() - startedAt : 0;
      startedAt = 0;
    };

    const start = () => {
      if (timer !== undefined || paused || !visible || reducedMotion.matches) return;
      startedAt = performance.now();
      timer = window.setInterval(() => {
        const cycleElapsed = elapsed + (performance.now() - startedAt);
        const nextIndex = Math.min(5, Math.floor(cycleElapsed / duration));
        if (nextIndex !== activeIndex) render(nextIndex);
        if (cycleElapsed >= duration * 6) {
          elapsed = 0;
          startedAt = performance.now();
          render(0);
        }
      }, 50);
    };

    const pause = () => { paused = true; stop(); };
    const resume = () => { paused = false; start(); };

    flow.addEventListener('pointerenter', pause);
    flow.addEventListener('pointerleave', resume);
    flow.addEventListener('focusin', pause);
    flow.addEventListener('focusout', resume);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) stop();
      else start();
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) start();
        else stop();
      }, { threshold: 0.2 });
      observer.observe(flow);
    } else {
      start();
    }
  });
</script>
