---
import { methodologySteps } from '../../content/methodology';
---

<section class="methodology-visual" data-methodology-flow aria-label="E Deviser's problem-solving process">
  <div class="methodology-visual-orbit" aria-hidden="true">
    <svg viewBox="0 0 1200 260" preserveAspectRatio="none">
      <defs>
        <linearGradient id="method-flow-gradient" x1="0" x2="1">
          <stop offset="0" stop-color="#9B72F2" stop-opacity=".08" />
          <stop offset=".28" stop-color="#168FD0" stop-opacity=".8" />
          <stop offset=".58" stop-color="#08C6C0" stop-opacity=".85" />
          <stop offset=".82" stop-color="#E9A83B" stop-opacity=".9" />
          <stop offset="1" stop-color="#36D78A" stop-opacity=".65" />
        </linearGradient>
        <filter id="method-flow-glow" x="-50%" y="-100%" width="200%" height="300%">
          <feGaussianBlur stdDeviation="5" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <path class="methodology-ribbon methodology-ribbon-soft" d="M0 132 C110 20 170 220 280 132 S450 44 560 132 S730 220 840 132 S1010 44 1200 132" />
      <path class="methodology-ribbon" d="M0 132 C110 20 170 220 280 132 S450 44 560 132 S730 220 840 132 S1010 44 1200 132" />
      <path class="methodology-ribbon methodology-ribbon-secondary" d="M0 132 C110 245 170 40 280 132 S450 220 560 132 S730 40 840 132 S1010 220 1200 132" />
      <g class="methodology-flow-particles" filter="url(#method-flow-glow)">
        <circle r="3"><animateMotion dur="9s" repeatCount="indefinite" path="M0 132 C110 20 170 220 280 132 S450 44 560 132 S730 220 840 132 S1010 44 1200 132" /></circle>
        <circle r="2"><animateMotion dur="12s" begin="-4s" repeatCount="indefinite" path="M0 132 C110 245 170 40 280 132 S450 220 560 132 S730 40 840 132 S1010 220 1200 132" /></circle>
        <circle r="2.5"><animateMotion dur="7s" begin="-2s" repeatCount="indefinite" path="M0 132 C110 20 170 220 280 132 S450 44 560 132 S730 220 840 132 S1010 44 1200 132" /></circle>
      </g>
    </svg>
    <div class="methodology-field-glow methodology-field-glow-start"></div>
    <div class="methodology-field-glow methodology-field-glow-end"></div>
  </div>

  <ol class="methodology-steps">
    {methodologySteps.map((step, index) => (
      <li class:list={['methodology-step', index === 0 ? 'is-active' : '']} data-methodology-step>
        <button
          class="methodology-step-trigger"
          type="button"
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-methodology-node
          data-index={index}
          aria-label={`Explore phase ${step.number}: ${step.title}`}
        >
          <span class="methodology-step-index">{step.number}</span>
          <span class="methodology-step-title">{index === 0 ? 'The Problem' : step.title}</span>
          <span class="methodology-step-indicator" aria-hidden="true"></span>
        </button>
        <p class="methodology-step-description">{step.description}</p>
      </li>
    ))}
  </ol>

  <div class="methodology-live-detail" aria-live="polite" aria-atomic="true">
    <span class="methodology-live-kicker">THE PROCESS, IN MOTION</span>
    <p data-methodology-detail>Every meaningful solution starts with a problem worth understanding.</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-methodology-flow]').forEach((flow) => {
    const steps = Array.from(flow.querySelectorAll<HTMLElement>('[data-methodology-step]'));
    const triggers = Array.from(flow.querySelectorAll<HTMLButtonElement>('[data-methodology-node]'));
    const detail = flow.querySelector<HTMLElement>('[data-methodology-detail]');
    const summaries = [
      'Every meaningful solution starts with a problem worth understanding.',
      'We investigate the domain, constraints, people, systems, and evidence.',
      'We determine what intelligence, technology, and solution are actually required.',
      'AI agents, software, data, and automation are combined only where they create value.',
      'A working system turns the chosen approach into something real and useful.',
      'We measure outcomes, learn from evidence, and improve what matters most.',
    ];

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        steps.forEach((step, stepIndex) => {
          const active = stepIndex === index;
          step.classList.toggle('is-active', active);
          triggers[stepIndex].setAttribute('aria-pressed', String(active));
        });
        if (detail) detail.textContent = summaries[index];
      });
    });
  });
</script>
