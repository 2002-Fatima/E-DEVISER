      <svg viewBox="0 0 760 560" aria-hidden="true">
        <defs>
          <linearGradient id="future-road">
            <stop stop-color="var(--brand-blue)" stop-opacity="0" />
            <stop offset=".52" stop-color="var(--brand-teal-light)" />
            <stop offset="1" stop-color="var(--brand-white)" />
          </linearGradient>
        </defs>
        <path d="M20 490 C190 440 230 360 340 335 S560 300 730 75" />
        <path d="M20 530 C185 480 255 420 365 385 S580 350 745 170" />
        <path d="M35 550 C200 510 280 475 400 440 S600 410 745 270" />
      </svg>

      <div class="wwb-future-horizon"><i></i></div>
      <div class="wwb-future-marker marker-a"><i></i><span>NEW CONTEXTS</span></div>
      <div class="wwb-future-marker marker-b"><i></i><span>NEW CHALLENGES</span></div>
      <div class="wwb-future-marker marker-c"><i></i><span>NEW POSSIBILITIES</span></div>
      <div class="wwb-future-art-foot">
        DIFFERENT PROBLEMS <i></i> SAME MINDSET <i></i> BETTER OUTCOMES
      </div>
    </div>
  </div>
</section>
