<section
  class="wwb-section wwb-method"
  id="our-way-of-building"
  aria-labelledby="wwb-method-title"
>
  <div class="wwb-shell">
    <p class="wwb-eyebrow">OUR WAY OF BUILDING</p>
    <div class="wwb-section-intro wwb-intro-split">
      <h2 id="wwb-method-title">Understand first.<br /><em>Build second.</em></h2>
      <p class="wwb-lead">
        We go deep into a problem—its people, incentives, systems, constraints, evidence, and
        desired outcomes—before deciding what needs to exist.
      </p>
    </div>

    <div class="wwb-method-track" data-wwb-method-track aria-label="Six stages of our problem-led process">
      <div class="wwb-method-rail" aria-hidden="true"><span></span></div>

      <article class="wwb-method-step wwb-method-step-1" data-wwb-method-step="0" aria-current="step">
        <button class="wwb-method-select" type="button" data-wwb-method-select="0" aria-pressed="true" aria-label="Show stage 01"><div class="wwb-method-node"><span>01</span><i></i></div></button>
        <p class="wwb-method-index">STAGE 01</p>
        <h3>PROBLEM</h3>
        <p>We start with the problem—not a predetermined technology or solution.</p>
        <div class="wwb-method-visual wwb-method-visual--problem" aria-hidden="true">
          <span class="method-problem-fragment method-problem-fragment--one"></span>
          <span class="method-problem-fragment method-problem-fragment--two"></span>
          <span class="method-problem-fragment method-problem-fragment--three"></span>
          <i class="method-problem-core"></i>
          <b>01 / THE CHALLENGE</b>
        </div>
      </article>

      <article class="wwb-method-step wwb-method-step-2" data-wwb-method-step="1">
        <button class="wwb-method-select" type="button" data-wwb-method-select="1" aria-pressed="false" aria-label="Show stage 02"><div class="wwb-method-node"><span>02</span><i></i></div></button>
        <p class="wwb-method-index">STAGE 02</p>
        <h3>UNDERSTAND</h3>
        <p>We immerse ourselves in the problem to understand its real context.</p>
        <div class="wwb-method-visual wwb-method-visual--understand" aria-hidden="true">
          <span class="method-lens method-lens--outer"></span>
          <span class="method-lens method-lens--middle"></span>
          <span class="method-lens method-lens--inner"></span>
          <i class="method-focus"></i>
          <i class="method-ray"></i>
          <b>02 / CONTEXT</b>
        </div>
      </article>

      <article class="wwb-method-step wwb-method-step-3" data-wwb-method-step="2">
        <button class="wwb-method-select" type="button" data-wwb-method-select="2" aria-pressed="false" aria-label="Show stage 03"><div class="wwb-method-node"><span>03</span><i></i></div></button>
        <p class="wwb-method-index">STAGE 03</p>
        <h3>DESIGN</h3>
        <p>We translate insights into a solution approach designed around the problem, not the tech.</p>
        <div class="wwb-method-visual wwb-method-visual--design" aria-hidden="true">
          <span class="method-blueprint method-blueprint--frame"></span>
          <span class="method-blueprint method-blueprint--diamond"></span>
          <span class="method-blueprint method-blueprint--axis"></span>
          <i class="method-blueprint-anchor"></i>
          <b>03 / STRUCTURE</b>
        </div>
      </article>

      <article class="wwb-method-step wwb-method-step-4" data-wwb-method-step="3">
        <button class="wwb-method-select" type="button" data-wwb-method-select="3" aria-pressed="false" aria-label="Show stage 04"><div class="wwb-method-node"><span>04</span><i></i></div></button>
        <p class="wwb-method-index">STAGE 04</p>
        <h3>BUILD</h3>
        <p>We build with the right mix of capabilities—whatever the problem actually requires.</p>
        <div class="wwb-method-visual wwb-method-visual--build" aria-hidden="true">
          <span class="method-module method-module--one"></span>
          <span class="method-module method-module--two"></span>
          <span class="method-module method-module--three"></span>
          <span class="method-module method-module--four"></span>
          <i class="method-module-joint"></i>
          <b>04 / EXECUTION</b>
        </div>
      </article>

      <article class="wwb-method-step wwb-method-step-5" data-wwb-method-step="4">
        <button class="wwb-method-select" type="button" data-wwb-method-select="4" aria-pressed="false" aria-label="Show stage 05"><div class="wwb-method-node"><span>05</span><i></i></div></button>
        <p class="wwb-method-index">STAGE 05</p>
        <h3>SOLVE</h3>
        <p>We deliver a working solution that people can use in the real world.</p>
        <div class="wwb-method-visual wwb-method-visual--solve" aria-hidden="true">
          <span class="method-bridge method-bridge--left"></span>
          <span class="method-bridge method-bridge--right"></span>
          <span class="method-bridge method-bridge--span"></span>
          <i class="method-bridge-point"></i>
          <b>05 / IN USE</b>
        </div>
      </article>

      <article class="wwb-method-step wwb-method-step-6" data-wwb-method-step="5">
        <button class="wwb-method-select" type="button" data-wwb-method-select="5" aria-pressed="false" aria-label="Show stage 06"><div class="wwb-method-node"><span>06</span><i></i></div></button>
        <p class="wwb-method-index">STAGE 06</p>
        <h3>MEASURE</h3>
        <p>We measure what matters and learn what needs to improve next.</p>
        <div class="wwb-method-visual wwb-method-visual--measure" aria-hidden="true">
          <span class="method-signal method-signal--ring"></span>
          <span class="method-signal method-signal--arc"></span>
          <span class="method-signal method-signal--trace"></span>
          <i class="method-signal-point"></i>
          <b>06 / LEARNING</b>
        </div>
      </article>
    </div>

    <div class="wwb-method-controls">
      <button class="wwb-method-toggle" type="button" data-wwb-method-toggle aria-pressed="false">
        <span aria-hidden="true">Ⅱ</span> <span data-wwb-method-toggle-label>Pause</span>
      </button>
    </div>

    <div class="wwb-method-principles">
      <p>
        We don’t start by asking, <em>“What can this technology do?”</em><br />
        We start by asking, <strong>“What would actually solve this?”</strong>
      </p>
      <div>
        <span>THIS IS NOT A LINEAR HANDOFF.</span>
        <small>Measurement feeds learning. Learning shapes the next iteration.</small>
        <span>WE DON’T DELIVER AND DISAPPEAR.</span>
        <small>We stay with the problem until it’s meaningfully solved.</small>
      </div>
    </div>
    <a class="wwb-next-link" href="#our-toolkit">NEXT: OUR TOOLKIT <span aria-hidden="true">↓</span></a>
  </div>

<script>
  document.querySelectorAll<HTMLElement>('[data-wwb-method-track]').forEach((track) => {
    if (track.dataset.initialized === 'true') return;
    track.dataset.initialized = 'true';
    const section = track.closest<HTMLElement>('.wwb-method');
    const stages = Array.from(track.querySelectorAll<HTMLElement>('[data-wwb-method-step]'));
    const controls = Array.from(track.querySelectorAll<HTMLButtonElement>('[data-wwb-method-select]'));
    const toggle = section?.querySelector<HTMLButtonElement>('[data-wwb-method-toggle]');
    const toggleLabel = section?.querySelector<HTMLElement>('[data-wwb-method-toggle-label]');
    const rail = track.querySelector<HTMLElement>('.wwb-method-rail span');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const abort = new AbortController();
    let active = 0;
    let timer: number | undefined;
    let visible = false;
    let paused = false;
    let hovered = false;
    let focused = false;
    let disposed = false;
    const interval = 4800;
    const stop = () => { if (timer !== undefined) window.clearTimeout(timer); timer = undefined; };
    const update = (index: number) => {
      active = index;
      stages.forEach((stage, i) => {
        if (i === index) stage.setAttribute('aria-current', 'step');
        else stage.removeAttribute('aria-current');
      });
      controls.forEach((control, i) => control.setAttribute('aria-pressed', String(i === index)));
      if (rail) rail.style.transform = 'scaleX(' + ((index + 1) / stages.length) + ')';
      track.dataset.activeIndex = String(index);
    };
    const schedule = () => {
      stop();
      const manuallyPaused = paused || reducedMotion.matches;
      if (toggle) {
        toggle.setAttribute('aria-pressed', String(manuallyPaused));
        toggle.setAttribute('aria-label', manuallyPaused ? 'Resume automatic progression' : 'Pause automatic progression');
        if (toggleLabel) toggleLabel.textContent = manuallyPaused ? 'Resume' : 'Pause';
        toggle.hidden = reducedMotion.matches;
      }
      if (disposed || paused || hovered || focused || !visible || document.hidden || reducedMotion.matches) return;
      timer = window.setTimeout(() => {
        update((active + 1) % stages.length);
        schedule();
      }, interval);
    };
    toggle?.addEventListener('click', () => { paused = !paused; schedule(); }, { signal: abort.signal });
    controls.forEach((control, index) => control.addEventListener('click', () => {
      update(index);
      schedule();
    }, { signal: abort.signal }));
    track.addEventListener('pointerenter', () => { hovered = true; schedule(); }, { signal: abort.signal });
    track.addEventListener('pointerleave', () => { hovered = false; schedule(); }, { signal: abort.signal });
    track.addEventListener('focusin', () => { focused = true; schedule(); }, { signal: abort.signal });
    track.addEventListener('focusout', (event) => {
      if (event instanceof FocusEvent && event.relatedTarget instanceof Node && track.contains(event.relatedTarget)) return;
      focused = false;
      schedule();
    }, { signal: abort.signal });
    const observer = new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.2);
      schedule();
    }, { threshold: [0, 0.2, 0.5] });
    if (section) observer.observe(section);
    document.addEventListener('visibilitychange', schedule, { signal: abort.signal });
    reducedMotion.addEventListener('change', schedule, { signal: abort.signal });
    const cleanup = () => {
      disposed = true;
      stop();
      observer.disconnect();
      abort.abort();
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    update(0);
    schedule();
  });
</script>

</section>
