.wb-dimension-stage:after{content:"";position:absolute;z-index:-1;left:8%;right:8%;top:2rem;height:1px;background:linear-gradient(90deg,transparent,#5ab9b44d 18%,#c0e2fd36 50%,#5ab9b44d 82%,transparent);transform-origin:center;animation:wb-dimension-scan 9s ease-in-out infinite alternate}
.wb-dimension-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(.65rem,2vw,1.35rem);position:relative;z-index:2}
