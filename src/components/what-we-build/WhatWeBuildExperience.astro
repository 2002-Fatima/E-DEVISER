.wb-dimension-card:before{content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,transparent,var(--dimension-accent),transparent);opacity:.8}
.wb-dimension-card:after{content:"";position:absolute;right:-2.7rem;bottom:-3.8rem;width:10rem;height:10rem;border:1px solid color-mix(in srgb,var(--dimension-accent) 32%,transparent);transform:rotate(45deg);box-shadow:0 0 0 13px #5ab9b408,0 0 0 27px #5ab9b405;transition:transform .6s ease}
.wb-dimension-card:hover{transform:translateY(-5px);border-color:var(--dimension-accent);background:linear-gradient(155deg,#143447f5,#0a1b28 72%)}
.wb-dimension-card:hover:after{transform:rotate(60deg) scale(1.08)}
