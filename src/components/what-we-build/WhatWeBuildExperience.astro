/* Our way of building: six connected stages with individual morphic signal forms. */
#way .wb-methodology-track{position:relative;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;margin:4.2rem 0 2.8rem;padding:0 0 1rem;isolation:isolate}
#way .wb-methodology-rail{position:absolute;z-index:-1;left:7.8%;right:7.8%;top:1.08rem;height:1px;background:linear-gradient(90deg,#0382bd70,#5ab9b4a8 48%,#c0e2fd88);overflow:hidden}
