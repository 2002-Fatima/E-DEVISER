#way .wb-method-node{position:relative;z-index:1;width:2.2rem;height:2.2rem;margin:.05rem 0 1.05rem;border:1px solid #5ab9b488;border-radius:50%;display:grid;place-items:center;background:#0a1c29;box-shadow:0 0 0 6px #5ab9b40b,0 0 22px #0382bd16;transition:border-color .3s ease,box-shadow .3s ease,transform .3s ease}
