<div class="home-hero-visual" aria-label="Animated cyan and turquoise light particles flowing into a luminous orbital nucleus">
  <canvas class="intelligence-field-canvas" id="intelligence-field-canvas" data-intelligence-field aria-hidden="true"></canvas>
  <div class="home-hero-stages" role="group" aria-label="Intelligence visualization states">
    <button class="stage-item" type="button" data-field-state="understand" aria-pressed="true" aria-controls="intelligence-field-canvas">
      <span class="stage-bullet" aria-hidden="true">◎</span><span>UNDERSTAND</span>
    </button>
    <button class="stage-item" type="button" data-field-state="decide" aria-pressed="false" aria-controls="intelligence-field-canvas">
      <span class="stage-bullet" aria-hidden="true">◌</span><span>DECIDE</span>
    </button>
    <button class="stage-item" type="button" data-field-state="act" aria-pressed="false" aria-controls="intelligence-field-canvas">
      <span class="stage-bullet" aria-hidden="true">▶</span><span>ACT</span>
    </button>
    <button class="stage-item" type="button" data-field-state="measure" aria-pressed="false" aria-controls="intelligence-field-canvas">
      <span class="stage-bullet" aria-hidden="true">◍</span><span>MEASURE</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLCanvasElement>('[data-intelligence-field]').forEach((canvas) => {
    const visual = canvas.parentElement;
    const context = canvas.getContext('2d');
    if (!visual || !context) return;

    type StreamParticle = {
      startX: number; lane: number; phase: number; speed: number;
      size: number; color: string; square: boolean;
    };
    type OrbitParticle = { angle: number; orbit: number; speed: number; size: number; color: string };
    type FieldState = 'understand' | 'decide' | 'act' | 'measure';

    const colors = ['#0382BD', '#2F9EAD', '#5AB9B4', '#C0E2FD', '#CDFCF4'];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controls = visual.querySelectorAll<HTMLButtonElement>('[data-field-state]');
    const random = (() => {
      let seed = 814729;
      return () => {
        seed = (seed * 1664525 + 1013904223) >>> 0;
        return seed / 4294967296;
      };
    })();

    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let streamParticles: StreamParticle[] = [];
    let orbitParticles: OrbitParticle[] = [];
    let frameId = 0;
    let previousFrame = 0;
    let elapsed = 0;
    let visible = true;
    let disposed = false;
    let activeState: FieldState = 'understand';

    const buildParticles = () => {
      streamParticles = [];
      orbitParticles = [];
      const count = Math.round(Math.min(1800, Math.max(850, width * height / 125)));
      for (let i = 0; i < count; i += 1) {
        const startX = -0.025 + random() * 0.66;
        const lane = (random() + random() + random() - 1.5) * (0.22 + (1 - startX / 0.66) * 0.38);
        const roll = random();
        const color = colors[roll > 0.985 ? 4 : roll > 0.75 ? 3 : roll > 0.3 ? 2 : roll > 0.08 ? 1 : 0];
        streamParticles.push({
          startX, lane, phase: random(), speed: 0.035 + random() * 0.065,
          size: random() > 0.94 ? 1.5 + random() * 1.2 : 0.55 + random() * 1.05,
          color, square: random() > 0.94,
        });
      }
      for (let i = 0; i < 150; i += 1) {
        orbitParticles.push({
          angle: random() * Math.PI * 2,
          orbit: 0.48 + random() * 1.5,
          speed: (random() > 0.5 ? 1 : -1) * (0.12 + random() * 0.34),
          size: 0.55 + random() * 1.25,
          color: colors[random() > 0.72 ? 3 : random() > 0.5 ? 2 : 1],
        });
      }
    };

    const resize = () => {
      const bounds = visual.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      width = bounds.width;
      height = bounds.height;
      pixelRatio = Math.min(window.devicePixelRatio || 1, 1.6);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      buildParticles();
      draw();
    };

    const drawFlowLines = (cx: number, cy: number, time: number, compression: number) => {
      const lineCount = Math.max(38, Math.round(height / 4.7));
      const focalRadiusX = height * 0.25;
      context.save();
      context.globalCompositeOperation = 'lighter';
      for (let i = 0; i < lineCount; i += 1) {
        const lane = (i / (lineCount - 1)) * 2 - 1;
        const spread = lane * height * 0.47 * compression;
        const drift = Math.sin(time * 0.22 + i * 0.41) * height * 0.018;
        const alpha = 0.14 + (1 - Math.abs(lane)) * 0.32;
        context.beginPath();
        context.moveTo(-width * 0.035, cy + spread + drift);
        context.bezierCurveTo(
          width * 0.18, cy + spread * 1.04 - drift,
          cx - focalRadiusX * 1.65, cy + spread * 0.76 + drift,
          cx - focalRadiusX * 0.56, cy + spread * 0.18,
        );
        context.bezierCurveTo(
          cx - focalRadiusX * 0.12, cy + spread * 0.035 - drift * 0.35,
          cx - focalRadiusX * 0.03, cy + spread * 0.012,
          cx + focalRadiusX * 0.1, cy + spread * 0.045,
        );
        const gradient = context.createLinearGradient(-width * 0.03, cy + spread, cx, cy);
        gradient.addColorStop(0, 'rgba(0, 145, 220, 0.02)');
        gradient.addColorStop(0.38, `rgba(3, 130, 189, ${alpha})`);
        gradient.addColorStop(0.76, i % 5 === 0 ? 'rgba(205, 252, 244, 0.82)' : 'rgba(90, 185, 180, 0.55)');
        gradient.addColorStop(1, 'rgba(185, 255, 245, 0.12)');
        context.strokeStyle = gradient;
        context.lineWidth = i % 7 === 0 ? 1.05 : 0.62;
        context.stroke();
      }
      context.restore();
    };

    const drawOrbit = (cx: number, cy: number, time: number) => {
      context.save();
      context.translate(cx, cy);
      context.globalCompositeOperation = 'lighter';

      // Fine, elliptical orbital contours around the focal nucleus.
      for (let i = 0; i < 13; i += 1) {
        const progress = i / 12;
        const rx = height * (0.105 + progress * 0.22);
        const ry = height * (0.13 + progress * 0.24);
        const wobble = Math.sin(time * 0.28 + i * 0.7) * 1.8;
        context.beginPath();
        context.ellipse(0, 0, rx + wobble, ry - wobble * 0.45, Math.sin(time * 0.12) * 0.025, 0, Math.PI * 2);
        context.strokeStyle = i % 4 === 0
          ? `rgba(90, 185, 180, ${0.24 + progress * 0.12})`
          : `rgba(3, 130, 189, ${0.12 + progress * 0.13})`;
        context.lineWidth = i % 4 === 0 ? 0.95 : 0.58;
        context.stroke();
      }

      // Small points orbit at different radii and directions, giving the rings life.
      for (const particle of orbitParticles) {
        const angle = particle.angle + time * particle.speed;
        const rx = height * (0.12 + particle.orbit * 0.105);
        const ry = height * (0.15 + particle.orbit * 0.115);
        const x = Math.cos(angle) * rx;
        const y = Math.sin(angle) * ry;
        context.globalAlpha = 0.38 + (Math.sin(angle * 2.4 + time) + 1) * 0.22;
        context.fillStyle = particle.color;
        context.beginPath();
        context.arc(x, y, particle.size, 0, Math.PI * 2);
        context.fill();
      }
      context.restore();
    };

    const drawCore = (cx: number, cy: number, time: number) => {
      context.save();
      context.globalCompositeOperation = 'lighter';
      const pulse = 1 + Math.sin(time * 1.45) * 0.055;

      const halo = context.createRadialGradient(cx, cy, 0, cx, cy, height * 0.31 * pulse);
      halo.addColorStop(0, 'rgba(255, 255, 241, 0.98)');
      halo.addColorStop(0.035, 'rgba(220, 255, 244, 0.94)');
      halo.addColorStop(0.12, 'rgba(101, 255, 231, 0.48)');
      halo.addColorStop(0.32, 'rgba(14, 208, 229, 0.17)');
      halo.addColorStop(0.68, 'rgba(0, 151, 221, 0.055)');
      halo.addColorStop(1, 'rgba(0, 151, 221, 0)');
      context.fillStyle = halo;
      context.beginPath();
      context.arc(cx, cy, height * 0.31 * pulse, 0, Math.PI * 2);
      context.fill();

      const nucleus = context.createRadialGradient(cx, cy, 0, cx, cy, height * 0.045);
      nucleus.addColorStop(0, 'rgba(255, 255, 246, 1)');
      nucleus.addColorStop(0.28, 'rgba(238, 255, 244, 1)');
      nucleus.addColorStop(0.56, 'rgba(183, 255, 237, 0.92)');
      nucleus.addColorStop(1, 'rgba(83, 255, 226, 0)');
      context.fillStyle = nucleus;
      context.beginPath();
      context.arc(cx, cy, height * 0.045, 0, Math.PI * 2);
      context.fill();

      context.fillStyle = 'rgba(255, 255, 238, 0.98)';
      context.shadowColor = 'rgba(207, 255, 243, 0.95)';
      context.shadowBlur = 16;
      context.beginPath();
      context.arc(cx, cy, Math.max(2.8, height * 0.012), 0, Math.PI * 2);
      context.fill();
      context.restore();
    };

    const draw = () => {
      if (!width || !height) return;
      const cx = width * (width < 700 ? 0.54 : 0.65);
      const cy = height * 0.51;
      const compress = activeState === 'decide' ? 0.72 : 1;
      context.clearRect(0, 0, width, height);

      drawFlowLines(cx, cy, elapsed, compress);

      context.save();
      context.globalCompositeOperation = 'lighter';
      for (const particle of streamParticles) {
        const life = (particle.phase + elapsed * particle.speed) % 1;
        const eased = life * life * (3 - 2 * life);
        const progress = activeState === 'act' ? 1 - eased : eased;
        const x0 = particle.startX * width;
        const x = x0 + (cx - x0) * progress;
        const spread = particle.lane * height * (0.34 + Math.max(0, 0.64 - particle.startX) * 0.58);
        const curved = Math.sin(progress * Math.PI) * particle.lane * height * 0.085;
        const y = cy + (spread * (1 - progress) + particle.lane * height * 0.012 * progress + curved) * compress;
        context.globalAlpha = 0.22 + progress * 0.72;
        context.fillStyle = particle.color;
        context.beginPath();
        if (particle.square) context.rect(x - particle.size * 0.5, y - particle.size * 0.5, particle.size, particle.size);
        else context.arc(x, y, particle.size, 0, Math.PI * 2);
        context.fill();
      }
      context.restore();

      if (activeState === 'act') {
        for (let i = 0; i < 7; i += 1) {
          const progress = (elapsed * 0.38 + i / 7) % 1;
          context.beginPath();
          context.arc(cx, cy, height * (0.12 + progress * 0.24), 0, Math.PI * 2);
          context.strokeStyle = `rgba(90, 185, 180, ${(1 - progress) * 0.42})`;
          context.lineWidth = 0.9;
          context.stroke();
        }
      }

      if (activeState === 'measure') {
        const scanX = cx + Math.sin(elapsed * 0.55) * width * 0.11;
        const scan = context.createLinearGradient(scanX, cy - height * 0.28, scanX, cy + height * 0.28);
        scan.addColorStop(0, 'rgba(192, 226, 253, 0)');
        scan.addColorStop(0.5, 'rgba(205, 252, 244, 0.65)');
        scan.addColorStop(1, 'rgba(192, 226, 253, 0)');
        context.strokeStyle = scan;
        context.lineWidth = 0.8;
        context.beginPath();
        context.moveTo(scanX, cy - height * 0.28);
        context.lineTo(scanX, cy + height * 0.28);
        context.stroke();
      }

      drawOrbit(cx, cy, elapsed);
      drawCore(cx, cy, elapsed);
    };

    const animate = (time: number) => {
      frameId = 0;
      if (disposed || !visible || document.hidden || reducedMotion.matches) return;
      if (time - previousFrame >= 33) {
        elapsed += Math.min(64, previousFrame ? time - previousFrame : 33) / 1000;
        previousFrame = time;
        draw();
      }
      frameId = window.requestAnimationFrame(animate);
    };

    const syncAnimation = () => {
      if (frameId) window.cancelAnimationFrame(frameId);
      frameId = 0;
      previousFrame = 0;
      if (reducedMotion.matches || document.hidden || !visible) {
        draw();
        return;
      }
      frameId = window.requestAnimationFrame(animate);
    };

    const listenerController = new AbortController();
    const listenerOptions = { signal: listenerController.signal };

    controls.forEach((button) => {
      button.addEventListener('click', () => {
        const state = button.dataset.fieldState;
        if (state !== 'understand' && state !== 'decide' && state !== 'act' && state !== 'measure') return;
        activeState = state;
        controls.forEach((control) => control.setAttribute('aria-pressed', String(control === button)));
        draw();
      }, listenerOptions);
    });

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(visual);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      syncAnimation();
    });
    intersectionObserver.observe(visual);
    window.addEventListener('resize', resize, { passive: true, ...listenerOptions });
    document.addEventListener('visibilitychange', syncAnimation, listenerOptions);
    reducedMotion.addEventListener('change', syncAnimation, listenerOptions);

    resize();
    syncAnimation();

    const cleanup = () => {
      disposed = true;
      if (frameId) window.cancelAnimationFrame(frameId);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      listenerController.abort();
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
