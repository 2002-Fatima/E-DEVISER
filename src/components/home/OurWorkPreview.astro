---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="atmosphere" class="home-work-section">
  <section class="container container-wide home-work-content" aria-labelledby="home-work-title">
    <header class="home-work-heading">
      <div class="home-work-copy">
        <p class="eyebrow">OUR WORK</p>
        <h2 id="home-work-title">Ideas are easy. Building is the work.</h2>
        <p>
          From initiatives and partnerships to forums and fieldwork, everything we do is driven by
          one purpose: to turn conviction into real impact.
        </p>
      </div>

      <div class="home-work-build-visual" aria-hidden="true">
        <svg class="home-work-build-art" viewBox="0 0 620 270" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="work-ribbon" x1="90" y1="80" x2="430" y2="160" gradientUnits="userSpaceOnUse">
              <stop stop-color="#8AF0D9" stop-opacity=".12"/>
              <stop offset=".46" stop-color="#43C9C0" stop-opacity=".9"/>
              <stop offset="1" stop-color="#48A9E8" stop-opacity=".82"/>
            </linearGradient>
            <linearGradient id="work-face-a" x1="360" y1="70" x2="500" y2="215" gradientUnits="userSpaceOnUse">
              <stop stop-color="#B9FFF0" stop-opacity=".28"/>
              <stop offset="1" stop-color="#078FC0" stop-opacity=".035"/>
            </linearGradient>
            <linearGradient id="work-face-b" x1="430" y1="95" x2="550" y2="215" gradientUnits="userSpaceOnUse">
              <stop stop-color="#43C9C0" stop-opacity=".22"/>
              <stop offset="1" stop-color="#0C5D86" stop-opacity=".04"/>
            </linearGradient>
            <radialGradient id="work-core" cx="0" cy="0" r="1" gradientTransform="translate(462 139) rotate(90) scale(94 112)" gradientUnits="userSpaceOnUse">
              <stop stop-color="#6CE6D1" stop-opacity=".2"/>
              <stop offset="1" stop-color="#6CE6D1" stop-opacity="0"/>
            </radialGradient>
            <filter id="work-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="5"/>
            </filter>
            <path id="work-label-idea" d="M34 52 Q140 12 248 52"/>
            <path id="work-label-brand" d="M242 62 Q330 24 418 62"/>
            <path id="work-label-building" d="M397 48 Q486 10 575 48"/>
          </defs>

          <g class="work-art-grid" stroke="#9AD9E2" stroke-opacity=".09" stroke-width=".7">
            <path d="M24 44H596M24 88H596M24 132H596M24 176H596M24 220H596"/>
            <path d="M68 24V246M112 24V246M156 24V246M200 24V246M244 24V246M288 24V246M332 24V246M376 24V246M420 24V246M464 24V246M508 24V246M552 24V246"/>
          </g>

          <ellipse cx="462" cy="143" rx="124" ry="105" fill="url(#work-core)"/>

          <g class="work-art-idea">
            <path d="M48 145C78 85 113 74 145 107C176 140 126 185 98 153C70 122 126 54 176 87C216 114 180 177 148 190" stroke="#9BF3DF" stroke-opacity=".76" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M42 170C82 207 120 212 151 178C181 146 205 81 240 98C267 111 247 152 222 164" stroke="#39BDB7" stroke-opacity=".8" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M75 67C104 41 148 47 173 70C200 94 190 124 169 134" stroke="#6CBDEB" stroke-opacity=".68" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M52 119C78 104 99 105 116 121M123 211C156 224 190 203 206 180" stroke="#D0FFF2" stroke-opacity=".42" stroke-width=".8" stroke-linecap="round"/>
            <path d="M30 93C65 132 22 178 69 198C105 214 122 171 151 154C183 135 208 150 232 127" stroke="#8CEBDD" stroke-opacity=".62" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 4"/>
            <path d="M63 54C96 82 118 23 162 51C203 77 162 111 192 129C215 143 237 120 253 99" stroke="#64BDE4" stroke-opacity=".58" stroke-width="1" stroke-linecap="round"/>
            <path d="M38 185C72 151 86 225 132 205C170 188 163 164 198 168C220 171 231 194 249 181" stroke="#B8FFF0" stroke-opacity=".48" stroke-width=".9" stroke-linecap="round"/>
            <path d="M87 36C113 62 126 85 111 103C94 124 63 110 57 135M155 47C184 63 203 87 188 107" stroke="#7ED8EA" stroke-opacity=".52" stroke-width=".85" stroke-linecap="round"/>
            <circle cx="31" cy="93" r="1.8" fill="#B8FFF0"/><circle cx="69" cy="198" r="2" fill="#79D9E5"/>
            <circle cx="232" cy="127" r="1.8" fill="#B8FFF0"/><circle cx="253" cy="99" r="1.4" fill="#8CEBDD"/>
            <circle cx="87" cy="36" r="1.5" fill="#C8FFF2"/><circle cx="249" cy="181" r="1.7" fill="#C8FFF2"/>
            <circle cx="52" cy="145" r="2.2" fill="#C7FFF1"/>
            <circle cx="145" cy="107" r="2.4" fill="#A5F4E1"/>
            <circle cx="176" cy="87" r="1.8" fill="#6CC6E8"/>
            <circle cx="222" cy="164" r="2" fill="#C7FFF1"/>
            <circle cx="98" cy="153" r="1.6" fill="#A5F4E1"/>
            <circle cx="206" cy="180" r="1.6" fill="#6CC6E8"/>
          </g>

          <g class="work-art-flow">
            <path d="M160 136C222 63 252 220 313 142C354 90 355 69 395 90C424 106 419 151 451 151" stroke="url(#work-ribbon)" stroke-width="20" stroke-linecap="round" opacity=".36" filter="url(#work-glow)"/>
            <path d="M160 136C222 63 252 220 313 142C354 90 355 69 395 90C424 106 419 151 451 151" stroke="url(#work-ribbon)" stroke-width="3.4" stroke-linecap="round"/>
            <path d="M177 176C234 224 260 86 316 129C357 160 364 194 405 174C426 164 436 144 457 137" stroke="#8BEAD9" stroke-opacity=".9" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M187 91C235 57 267 193 326 151C366 122 363 89 411 107C438 117 434 151 464 156" stroke="#4CCFC5" stroke-opacity=".72" stroke-width="1.15" stroke-linecap="round"/>
            <path d="M204 199C246 160 269 112 300 119C344 128 352 211 401 188" stroke="#A4F6E7" stroke-opacity=".55" stroke-width=".9" stroke-linecap="round"/>
            <path d="M190 103C233 118 256 175 292 163C329 151 346 104 379 113" stroke="#56BCE1" stroke-opacity=".65" stroke-width=".9" stroke-linecap="round"/>
            <circle cx="313" cy="142" r="4" fill="#B8FFF0"/>
            <circle cx="313" cy="142" r="12" stroke="#6CE6D1" stroke-opacity=".32"/>
          </g>

          <g class="work-art-structure">
            <!-- A layered, folded morphic volume: organic geometry rather than a closed box. -->
            <path d="M367 139C374 99 410 67 451 61C491 54 536 76 557 111C577 145 561 190 529 213C496 238 448 239 411 218C378 200 358 172 367 139Z" fill="url(#work-face-a)" fill-opacity=".42" stroke="#9CF2E3" stroke-opacity=".64" stroke-width="1.1"/>
            <path d="M385 143C390 108 421 83 455 78C491 72 524 92 541 120C557 148 541 179 515 198C488 219 451 221 421 205C394 190 379 167 385 143Z" fill="url(#work-face-b)" fill-opacity=".56" stroke="#62D8D0" stroke-opacity=".7" stroke-width="1"/>
            <path d="M407 145C410 119 432 99 458 96C485 93 509 109 519 131C530 154 512 178 492 190C468 205 441 199 423 184C410 173 404 159 407 145Z" fill="url(#work-core)" stroke="#B5FFF0" stroke-opacity=".66" stroke-width="1"/>
            <path d="M369 139C396 126 408 95 438 79C468 62 505 77 525 102C545 128 535 160 512 181C485 205 451 222 420 207C389 192 376 166 369 139Z" stroke="#C1FFF1" stroke-opacity=".58" stroke-width="1.1"/>
            <path d="M385 143C410 151 427 176 455 184C486 193 516 170 541 120M399 108C420 124 435 145 462 151C492 158 519 139 557 111" stroke="#8CEBDD" stroke-opacity=".62" stroke-width="1"/>
            <path d="M367 139C403 139 423 111 451 94C479 77 510 92 541 120M380 178C414 167 430 143 458 132C490 119 519 137 557 111" stroke="#70CFE3" stroke-opacity=".55" stroke-width=".9"/>
            <path d="M411 218C423 185 422 153 438 125C453 99 480 84 505 78M451 61C444 95 458 119 480 139C503 160 528 172 529 213" stroke="#B8FFF0" stroke-opacity=".42" stroke-width=".85"/>
            <path d="M385 143C415 111 438 107 455 78M421 205C433 176 463 163 492 190M407 145C437 150 463 132 480 139M438 79C445 110 432 145 407 145M505 78C492 112 498 149 515 198" stroke="#A7F6E8" stroke-opacity=".38" stroke-width=".8" stroke-dasharray="3 4"/>
            <!-- Interlocking inner membranes create depth and a sense of continuous construction. -->
            <path d="M388 124C415 79 467 66 506 91C541 113 546 157 516 188C485 220 433 214 402 181C382 160 376 143 388 124Z" stroke="#55C9D0" stroke-opacity=".72" stroke-width="1.25"/>
            <path d="M399 162C414 125 444 103 474 106C506 108 526 135 518 160C509 190 474 205 444 193C424 185 408 176 399 162Z" stroke="#B7FFF0" stroke-opacity=".56" stroke-width=".9"/>
            <path d="M393 113C425 137 445 165 475 169C504 174 526 153 541 120M385 168C417 182 443 194 471 188C500 182 520 160 529 139" stroke="#5DBFE0" stroke-opacity=".52" stroke-width=".85"/>
            <path d="M420 88C432 112 447 128 469 137C492 147 512 145 534 131M407 190C428 166 448 150 473 145C500 140 521 153 538 176" stroke="#C6FFF3" stroke-opacity=".38" stroke-width=".75"/>
            <!-- Fine connective topology: the form behaves like a system, not a solid object. -->
            <g stroke="#A7F4E8" stroke-opacity=".52" stroke-width=".75">
              <path d="M385 143L420 88L455 78L505 78L541 120L557 111"/>
              <path d="M385 143L399 162L421 205L411 218"/>
              <path d="M420 88L438 79L451 61M455 78L474 106L505 78"/>
              <path d="M399 162L407 145L438 125L455 78"/>
              <path d="M407 145L444 193L421 205M438 125L469 137L492 190"/>
              <path d="M474 106L480 139L515 198L529 213"/>
              <path d="M469 137L475 169L471 188L492 190"/>
              <path d="M480 139L518 160L541 120M516 188L529 213"/>
            </g>
            <g stroke="#5CC9D0" stroke-opacity=".52" stroke-width=".7" stroke-dasharray="2 4">
              <path d="M367 139L438 125L474 106L557 111"/>
              <path d="M380 178L407 145L455 78L525 102"/>
              <path d="M388 124L444 193L516 188"/>
              <path d="M393 113L469 137L541 120"/>
              <path d="M402 181L455 151L518 160"/>
            </g>
            <!-- Luminous junctions mark the points where the system resolves into order. -->
            <g fill="#C8FFF2">
              <circle cx="455" cy="78" r="2.5"/><circle cx="541" cy="120" r="2.2"/>
              <circle cx="469" cy="137" r="3"/><circle cx="407" cy="145" r="2.2"/>
              <circle cx="492" cy="190" r="2.3"/><circle cx="421" cy="205" r="1.9"/>
              <circle cx="505" cy="78" r="1.8"/><circle cx="438" cy="125" r="1.7"/>
              <circle cx="518" cy="160" r="1.8"/><circle cx="475" cy="169" r="1.6"/>
            </g>
            <g fill="#65D6D0" opacity=".78">
              <circle cx="455" cy="78" r="5" filter="url(#work-glow)"/>
              <circle cx="469" cy="137" r="8" filter="url(#work-glow)"/>
              <circle cx="492" cy="190" r="5" filter="url(#work-glow)"/>
            </g>
            <path d="M369 139C390 91 437 49 484 58C535 67 571 112 562 157C554 203 509 237 463 236" stroke="#7BE5D9" stroke-opacity=".3" stroke-width=".8" stroke-dasharray="2 6"/>
          </g>

          <g class="work-art-sparkles" fill="#C8FFF2">
            <circle cx="265" cy="74" r="1.6"/>
            <circle cx="342" cy="206" r="1.3"/>
            <circle cx="574" cy="71" r="1.5"/>
            <circle cx="565" cy="218" r="1.2"/>
            <circle cx="287" cy="222" r="1"/>
          </g>
          <path class="work-art-orbit" d="M342 143C376 24 525 23 574 127C610 204 507 257 430 239" stroke="#65D6D0" stroke-opacity=".26" stroke-width=".8" stroke-dasharray="2 7"/>
          <g class="work-art-labels" aria-hidden="true">
            <text class="work-art-label"><textPath href="#work-label-idea" startOffset="50%" text-anchor="middle">IDEA</textPath></text>
            <text class="work-art-label work-art-label--brand"><textPath href="#work-label-brand" startOffset="50%" text-anchor="middle">E DEVISER</textPath></text>
            <text class="work-art-label"><textPath href="#work-label-building" startOffset="50%" text-anchor="middle">BUILDING</textPath></text>
          </g>

        </svg>
      </div>
    </header>

    <article class="home-work-feature" aria-labelledby="home-work-feature-title">
      <div class="home-work-feature-copy">
        <p class="home-work-feature-label"><span></span> FEATURED</p>
        <p class="home-work-feature-kicker">AI × FUTURE FORUM</p>
        <h3 id="home-work-feature-title">Shaping what&apos;s next.</h3>
        <p>
          Bringing together global leaders, educators, researchers, and innovators to explore how
          AI is redefining the future of learning and society.
        </p>
        <a class="home-work-feature-link" href="/our-work/#forums-events">
          View Highlights <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="home-work-feature-media">
        <div
          class="home-work-image-placeholder home-work-image-placeholder--feature"
          role="img"
          aria-label="Featured AI Future Forum image placeholder, awaiting event photography"
        ><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">FEATURE IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">AI × Future Forum</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
      </figure>
    </article>

    <div class="home-work-gallery-heading">
      <div>
        <p class="eyebrow">OUR WORK</p>
        <h3>Areas of work</h3>
      </div>
    </div>

    <div class="home-work-gallery" aria-label="Selected work and event highlights">
      <article class="home-work-gallery-item home-work-gallery-item--wide">
        <div class="home-work-gallery-image home-work-gallery-image--one" role="img" aria-label="Initiatives image placeholder, awaiting project photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">Initiatives & programmes</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">INITIATIVES</p>
            <h4>We start what matters.</h4>
            <p>Initiatives and programs we create to solve real problems and drive lasting change.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#initiatives" aria-label="Explore initiatives">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item">
        <div class="home-work-gallery-image home-work-gallery-image--two" role="img" aria-label="Partnerships image placeholder, awaiting collaboration photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">People & partnerships</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">PARTNERSHIPS</p>
            <h4>Stronger together.</h4>
            <p>Collaborations with institutions, governments, universities, and organizations that amplify impact.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#partnerships" aria-label="Explore partnerships">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item">
        <div class="home-work-gallery-image home-work-gallery-image--three" role="img" aria-label="Forums and events image placeholder, awaiting event photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">Forums & gatherings</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">FORUMS &amp; EVENTS</p>
            <h4>Conversations that build the future.</h4>
            <p>Forums, summits, and events that spark dialogue, share knowledge, and shape the ecosystem.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#forums-events" aria-label="Explore forums and events">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item home-work-gallery-item--wide">
        <div class="home-work-gallery-image home-work-gallery-image--four" role="img" aria-label="Fieldwork image placeholder, awaiting documentary photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">Fieldwork & impact</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">IN THE FIELD</p>
            <h4>On the ground. In the real world.</h4>
            <p>Workshops, visits, research, and engagements that keep us close to the problems we solve.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#in-the-field" aria-label="Explore work in the field">↗</a>
        </div>
      </article>
    </div>

    <footer class="home-work-footer">
      <div>
        <p class="home-work-footer-title">Progress is built together.</p>
        <p>See more initiatives, partnerships, events, and moments from the field.</p>
      </div>
      <Button href="/our-work/" label="Explore Our Work" variant="primary" />
    </footer>
  </section>
</SectionWrapper>

<style>
  .home-work-build-visual {
    position: relative;
    display: grid;
    align-items: center;
    width: 100%;
    min-width: 0;
    min-height: clamp(19rem, 27vw, 24rem);
    overflow: visible;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 74% 50%, rgba(3, 130, 189, 0.2), transparent 42%),
      radial-gradient(ellipse at 34% 52%, rgba(9, 185, 156, 0.14), transparent 48%);
  }

  .home-work-build-art {
    display: block;
    width: 116%;
    max-width: none;
    height: auto;
    margin-inline: -12%;
    overflow: visible;
    filter: drop-shadow(0 0 1.5rem rgba(36, 181, 190, 0.12));
  }

  .work-art-grid {
    opacity: 0.55;
    mask-image: radial-gradient(ellipse at 62% 50%, #000 8%, transparent 82%);
  }

  .work-art-idea {
    transform-origin: 145px 136px;
    animation: work-idea-drift 8s ease-in-out infinite;
  }

  .work-art-flow path:first-child {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: work-ribbon-draw 7s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-flow path:nth-child(2) {
    stroke-dasharray: 390;
    stroke-dashoffset: 390;
    animation: work-ribbon-draw 7s 0.35s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-flow path:nth-child(3) {
    stroke-dasharray: 280;
    stroke-dashoffset: 280;
    animation: work-ribbon-draw 7s 0.7s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-flow path:nth-child(4) {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: work-ribbon-draw 7s 1s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-flow path:nth-child(5) {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: work-ribbon-draw 7s 1.3s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-structure {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: work-structure-arrive 7s cubic-bezier(.2, .75, .2, 1) infinite;
  }

  .work-art-sparkles {
    animation: work-sparkle-breathe 4s ease-in-out infinite alternate;
  }

  .work-art-orbit {
    transform-box: fill-box;
    transform-origin: center;
    animation: work-orbit-turn 22s linear infinite;
  }

  @keyframes work-idea-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0); opacity: .76; }
    50% { transform: translate3d(7px, -6px, 0) rotate(4deg); opacity: 1; }
  }

  @keyframes work-ribbon-draw {
    0% { stroke-dashoffset: 420; opacity: .12; }
    38%, 78% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: -420; opacity: .16; }
  }

  @keyframes work-structure-arrive {
    0%, 12% { opacity: .12; transform: translate3d(0, 14px, 0) scale(.9); }
    42%, 82% { opacity: 1; transform: translate3d(0, 0, 0) scale(1.04); }
    100% { opacity: .28; transform: translate3d(0, -4px, 0) scale(1.06); }
  }

  @keyframes work-sparkle-breathe {
    from { opacity: .35; }
    to { opacity: 1; }
  }

  @keyframes work-orbit-turn {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 48rem) {
    .home-work-build-visual {
      min-height: 0;
      aspect-ratio: 1.8 / 1;
      justify-self: stretch;
    }

    .home-work-build-art {
      width: 112%;
      margin-inline: -6%;
    }
  }

  @media (max-width: 36rem) {
    .home-work-build-visual {
      aspect-ratio: 1.55 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-art-idea,
    .work-art-flow path,
    .work-art-structure,
    .work-art-sparkles,
    .work-art-orbit {
      animation: none;
    }

    .work-art-flow path {
      stroke-dashoffset: 0;
    }
  }

  /* Final morphic composition tuning: borderless, expansive, balanced with the copy. */
  .home-work-build-visual {
    width: 100%;
    min-height: clamp(20rem, 30vw, 27rem);
    padding-inline: 5%;
    box-sizing: border-box;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .home-work-build-art {
    width: 140%;
    max-width: none;
    margin-inline: -20%;
    overflow: visible;
    transform: scaleX(1.75);
    transform-origin: center;
  }

  .work-art-label {
    fill: rgba(194, 248, 240, 0.82);
    font-family: var(--font-mono), "SFMono-Regular", Consolas, monospace;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 2.4px;
    paint-order: stroke;
    stroke: rgba(7, 24, 37, 0.72);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .work-art-label--brand {
    fill: #C7FFF2;
    font-size: 8.5px;
    letter-spacing: 2.8px;
  }

  @media (max-width: 62rem) {
    .home-work-build-visual {
      min-height: clamp(18rem, 28vw, 23rem);
      padding-inline: 3%;
    }
    .home-work-build-art {
      width: 132%;
      margin-inline: -16%;
    }
  }

  @media (max-width: 48rem) {
    .home-work-build-visual {
