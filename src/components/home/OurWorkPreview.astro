---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="atmosphere" class="home-work-section">
  <section class="container container-wide home-work-content" aria-labelledby="home-work-title">
    <header class="home-work-heading">
      <div class="home-work-copy">
        <p class="eyebrow">OUR WORK</p>
        <h2 id="home-work-title">Ideas are easy. Building is the work.</h2>
        <p>
          From initiatives and partnerships to forums and fieldwork, everything we do is driven by
          one purpose: to turn conviction into real impact.
        </p>
      </div>
    </header>

    <article class="home-work-feature" aria-labelledby="home-work-feature-title">
      <div class="home-work-feature-copy">
        <p class="home-work-feature-label"><span></span> FEATURED</p>
        <p class="home-work-feature-kicker">AI × FUTURE FORUM</p>
        <h3 id="home-work-feature-title">Shaping what&apos;s next.</h3>
        <p>
          Bringing together global leaders, educators, researchers, and innovators to explore how
          AI is redefining the future of learning and society.
        </p>
        <a class="home-work-feature-link" href="/our-work/#forums-events">
          View Highlights <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="home-work-feature-media">
        <div
          class="home-work-image-placeholder home-work-image-placeholder--feature"
          role="img"
          aria-label="Featured AI Future Forum image area"
        ></div>
      </figure>
    </article>

    <div class="home-work-gallery-heading">
      <div>
        <p class="eyebrow">OUR WORK</p>
        <h3>Areas of work</h3>
      </div>
      <div class="home-work-morphic-lens" aria-hidden="true">
        <span class="home-work-morphic-lens-core"></span>
        <span class="home-work-morphic-lens-orbit home-work-morphic-lens-orbit--one"></span>
        <span class="home-work-morphic-lens-orbit home-work-morphic-lens-orbit--two"></span>
        <span class="home-work-morphic-lens-glint"></span>
      </div>
    </div>

    <div class="home-work-gallery" aria-label="Selected work and event highlights">
      <article class="home-work-gallery-item home-work-gallery-item--wide">
        <div class="home-work-gallery-image home-work-gallery-image--one" role="img" aria-label="initiatives image area"></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">INITIATIVES</p>
            <h4>We start what matters.</h4>
            <p>Initiatives and programs we create to solve real problems and drive lasting change.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#initiatives" aria-label="Explore initiatives">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item">
        <div class="home-work-gallery-image home-work-gallery-image--two" role="img" aria-label="partnerships image area"></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">PARTNERSHIPS</p>
            <h4>Stronger together.</h4>
            <p>Collaborations with institutions, governments, universities, and organizations that amplify impact.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#partnerships" aria-label="Explore partnerships">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item">
        <div class="home-work-gallery-image home-work-gallery-image--three" role="img" aria-label="forums and events image area"></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">FORUMS &amp; EVENTS</p>
            <h4>Conversations that build the future.</h4>
            <p>Forums, summits, and events that spark dialogue, share knowledge, and shape the ecosystem.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#forums-events" aria-label="Explore forums and events">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item home-work-gallery-item--wide">
        <div class="home-work-gallery-image home-work-gallery-image--four" role="img" aria-label="work in the field image area"></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">IN THE FIELD</p>
            <h4>On the ground. In the real world.</h4>
            <p>Workshops, visits, research, and engagements that keep us close to the problems we solve.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#in-the-field" aria-label="Explore work in the field">↗</a>
        </div>
      </article>
    </div>

    <footer class="home-work-footer">
      <div>
        <p class="home-work-footer-title">Progress is built together.</p>
        <p>See more initiatives, partnerships, events, and moments from the field.</p>
      </div>
      <Button href="/our-work/" label="Explore Our Work" variant="primary" />
    </footer>
  </section>
</SectionWrapper>
