---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper>
  <div class="container preview-panel">
    <div class="preview-copy">
      <p class="eyebrow">OUR WORK</p>
      <h2>Initiatives, partnerships, learning, and field work.</h2>
      <p>Our work spans multiple channels of practice, including collaborative initiatives, public-facing programs, and applied learning environments.</p>
    </div>
    <div class="preview-action">
      <Button href="/our-work/" label="Explore our work" />
    </div>
  </div>
</SectionWrapper>
