---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="atmosphere" class="home-work-section">
  <section class="container container-wide home-work-content" aria-labelledby="home-work-title">
    <header class="home-work-heading">
      <div class="home-work-copy">
        <p class="eyebrow">OUR WORK</p>
        <h2 id="home-work-title">Ideas are easy. Building is the work.</h2>
        <p>
          From initiatives and partnerships to forums and fieldwork, everything we do is driven by
          one purpose: to turn conviction into real impact.
        </p>
      </div>

      <div class="home-work-build-visual" aria-hidden="true">
        <svg class="home-work-build-art" viewBox="0 0 620 270" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="work-ribbon" x1="90" y1="80" x2="430" y2="160" gradientUnits="userSpaceOnUse">
              <stop stop-color="#8AF0D9" stop-opacity=".12"/>
              <stop offset=".46" stop-color="#43C9C0" stop-opacity=".9"/>
              <stop offset="1" stop-color="#48A9E8" stop-opacity=".82"/>
            </linearGradient>
            <linearGradient id="work-face-a" x1="360" y1="70" x2="500" y2="215" gradientUnits="userSpaceOnUse">
              <stop stop-color="#B9FFF0" stop-opacity=".28"/>
              <stop offset="1" stop-color="#078FC0" stop-opacity=".035"/>
            </linearGradient>
            <linearGradient id="work-face-b" x1="430" y1="95" x2="550" y2="215" gradientUnits="userSpaceOnUse">
              <stop stop-color="#43C9C0" stop-opacity=".22"/>
              <stop offset="1" stop-color="#0C5D86" stop-opacity=".04"/>
            </linearGradient>
            <radialGradient id="work-core" cx="0" cy="0" r="1" gradientTransform="translate(462 139) rotate(90) scale(94 112)" gradientUnits="userSpaceOnUse">
              <stop stop-color="#6CE6D1" stop-opacity=".2"/>
              <stop offset="1" stop-color="#6CE6D1" stop-opacity="0"/>
            </radialGradient>
            <filter id="work-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="5"/>
            </filter>
          </defs>

          <g class="work-art-grid" stroke="#9AD9E2" stroke-opacity=".09" stroke-width=".7">
            <path d="M24 44H596M24 88H596M24 132H596M24 176H596M24 220H596"/>
            <path d="M68 24V246M112 24V246M156 24V246M200 24V246M244 24V246M288 24V246M332 24V246M376 24V246M420 24V246M464 24V246M508 24V246M552 24V246"/>
          </g>

          <ellipse cx="462" cy="143" rx="124" ry="105" fill="url(#work-core)"/>

          <g class="work-art-idea">
            <path d="M48 145C78 85 113 74 145 107C176 140 126 185 98 153C70 122 126 54 176 87C216 114 180 177 148 190" stroke="#9BF3DF" stroke-opacity=".76" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M42 170C82 207 120 212 151 178C181 146 205 81 240 98C267 111 247 152 222 164" stroke="#39BDB7" stroke-opacity=".8" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M75 67C104 41 148 47 173 70C200 94 190 124 169 134" stroke="#6CBDEB" stroke-opacity=".68" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M52 119C78 104 99 105 116 121M123 211C156 224 190 203 206 180" stroke="#D0FFF2" stroke-opacity=".42" stroke-width=".8" stroke-linecap="round"/>
            <circle cx="52" cy="145" r="2.2" fill="#C7FFF1"/>
            <circle cx="145" cy="107" r="2.4" fill="#A5F4E1"/>
            <circle cx="176" cy="87" r="1.8" fill="#6CC6E8"/>
            <circle cx="222" cy="164" r="2" fill="#C7FFF1"/>
            <circle cx="98" cy="153" r="1.6" fill="#A5F4E1"/>
            <circle cx="206" cy="180" r="1.6" fill="#6CC6E8"/>
          </g>

          <g class="work-art-flow">
            <path d="M160 136C222 63 252 220 313 142C354 90 355 69 395 90C424 106 419 151 451 151" stroke="url(#work-ribbon)" stroke-width="12" stroke-linecap="round" opacity=".22" filter="url(#work-glow)"/>
            <path d="M160 136C222 63 252 220 313 142C354 90 355 69 395 90C424 106 419 151 451 151" stroke="url(#work-ribbon)" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M177 176C234 224 260 86 316 129C357 160 364 194 405 174C426 164 436 144 457 137" stroke="#8BEAD9" stroke-opacity=".78" stroke-width="1.15" stroke-linecap="round"/>
            <path d="M190 103C233 118 256 175 292 163C329 151 346 104 379 113" stroke="#56BCE1" stroke-opacity=".65" stroke-width=".9" stroke-linecap="round"/>
            <circle cx="313" cy="142" r="4" fill="#B8FFF0"/>
            <circle cx="313" cy="142" r="12" stroke="#6CE6D1" stroke-opacity=".32"/>
          </g>

          <g class="work-art-structure">
            <path d="M375 112L458 58L548 106L466 163L375 112Z" fill="url(#work-face-a)" stroke="#A8F5E7" stroke-opacity=".82" stroke-width="1.2"/>
            <path d="M375 112V184L466 235V163L375 112Z" fill="#0B7894" fill-opacity=".12" stroke="#69D9D0" stroke-opacity=".72" stroke-width="1.1"/>
            <path d="M466 163L548 106V177L466 235V163Z" fill="url(#work-face-b)" stroke="#5CBFE1" stroke-opacity=".78" stroke-width="1.1"/>
            <path d="M405 94L488 143L520 124M405 94V165L488 213V143L405 94Z" stroke="#B7FFF0" stroke-opacity=".5" stroke-width=".9"/>
            <path d="M488 143L520 124V194L488 213" stroke="#72D9D5" stroke-opacity=".6" stroke-width=".9"/>
            <path d="M375 112L405 94L488 143L466 163L375 112Z" fill="#B5FFF0" fill-opacity=".08"/>
            <path d="M458 58V128L466 163M548 106L520 124L488 143" stroke="#C5FFF3" stroke-opacity=".68" stroke-width="1"/>
            <path d="M375 184L405 165L488 213L466 235" stroke="#43BDBB" stroke-opacity=".7" stroke-width="1"/>
            <path d="M405 94L458 58M488 143L548 106M488 213L548 177" stroke="#B8FFF0" stroke-opacity=".4" stroke-width=".8"/>
            <path d="M420 84L502 132L502 203M437 72L520 119L520 194" stroke="#A1EDE4" stroke-opacity=".28" stroke-width=".75"/>
            <path d="M393 123V174M432 145V198M510 118V187" stroke="#A1EDE4" stroke-opacity=".28" stroke-width=".75"/>
            <circle cx="458" cy="58" r="2.4" fill="#D0FFF3"/>
            <circle cx="548" cy="106" r="2.2" fill="#9DEFE4"/>
            <circle cx="466" cy="163" r="2.6" fill="#D0FFF3"/>
            <circle cx="466" cy="235" r="2" fill="#76DCD5"/>
            <circle cx="375" cy="112" r="2" fill="#B5FFF0"/>
          </g>

          <g class="work-art-sparkles" fill="#C8FFF2">
            <circle cx="265" cy="74" r="1.6"/>
            <circle cx="342" cy="206" r="1.3"/>
            <circle cx="574" cy="71" r="1.5"/>
            <circle cx="565" cy="218" r="1.2"/>
            <circle cx="287" cy="222" r="1"/>
          </g>
          <path class="work-art-orbit" d="M342 143C376 24 525 23 574 127C610 204 507 257 430 239" stroke="#65D6D0" stroke-opacity=".26" stroke-width=".8" stroke-dasharray="2 7"/>
        </svg>
      </div>
    </header>

    <article class="home-work-feature" aria-labelledby="home-work-feature-title">
      <div class="home-work-feature-copy">
        <p class="home-work-feature-label"><span></span> FEATURED</p>
        <p class="home-work-feature-kicker">AI × FUTURE FORUM</p>
        <h3 id="home-work-feature-title">Shaping what&apos;s next.</h3>
        <p>
          Bringing together global leaders, educators, researchers, and innovators to explore how
          AI is redefining the future of learning and society.
        </p>
        <a class="home-work-feature-link" href="/our-work/#forums-events">
          View Highlights <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="home-work-feature-media">
        <div
          class="home-work-image-placeholder home-work-image-placeholder--feature"
          role="img"
          aria-label="Featured AI Future Forum image placeholder, awaiting event photography"
        ><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">FEATURE IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">AI × Future Forum</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
      </figure>
    </article>

    <div class="home-work-gallery-heading">
      <div>
        <p class="eyebrow">OUR WORK</p>
        <h3>Areas of work</h3>
      </div>
    </div>

    <div class="home-work-gallery" aria-label="Selected work and event highlights">
      <article class="home-work-gallery-item home-work-gallery-item--wide">
        <div class="home-work-gallery-image home-work-gallery-image--one" role="img" aria-label="Initiatives image placeholder, awaiting project photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">Initiatives & programmes</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">INITIATIVES</p>
            <h4>We start what matters.</h4>
            <p>Initiatives and programs we create to solve real problems and drive lasting change.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#initiatives" aria-label="Explore initiatives">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item">
        <div class="home-work-gallery-image home-work-gallery-image--two" role="img" aria-label="Partnerships image placeholder, awaiting collaboration photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">People & partnerships</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">PARTNERSHIPS</p>
            <h4>Stronger together.</h4>
            <p>Collaborations with institutions, governments, universities, and organizations that amplify impact.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#partnerships" aria-label="Explore partnerships">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item">
        <div class="home-work-gallery-image home-work-gallery-image--three" role="img" aria-label="Forums and events image placeholder, awaiting event photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">Forums & gatherings</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">FORUMS &amp; EVENTS</p>
            <h4>Conversations that build the future.</h4>
            <p>Forums, summits, and events that spark dialogue, share knowledge, and shape the ecosystem.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#forums-events" aria-label="Explore forums and events">↗</a>
        </div>
      </article>

      <article class="home-work-gallery-item home-work-gallery-item--wide">
        <div class="home-work-gallery-image home-work-gallery-image--four" role="img" aria-label="Fieldwork image placeholder, awaiting documentary photography"><span class="home-work-media-state">
            <span class="home-work-media-state-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="home-work-media-state-label">IMAGE INCOMING</span>
            <span class="home-work-media-state-detail">Fieldwork & impact</span>
            <span class="home-work-media-state-track" aria-hidden="true"><i></i></span>
          </span></div>
        <div class="home-work-gallery-caption">
          <div>
            <p class="home-work-gallery-kicker">IN THE FIELD</p>
            <h4>On the ground. In the real world.</h4>
            <p>Workshops, visits, research, and engagements that keep us close to the problems we solve.</p>
          </div>
          <a class="home-work-gallery-link" href="/our-work/#in-the-field" aria-label="Explore work in the field">↗</a>
        </div>
      </article>
    </div>

    <footer class="home-work-footer">
      <div>
        <p class="home-work-footer-title">Progress is built together.</p>
        <p>See more initiatives, partnerships, events, and moments from the field.</p>
      </div>
      <Button href="/our-work/" label="Explore Our Work" variant="primary" />
    </footer>
  </section>
</SectionWrapper>

<style>
  .home-work-build-visual {
    position: relative;
    display: grid;
    align-items: center;
    min-width: 0;
    min-height: clamp(10rem, 19vw, 15rem);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 76% 48%, rgba(3, 130, 189, 0.13), transparent 38%),
      radial-gradient(ellipse at 34% 54%, rgba(9, 185, 156, 0.08), transparent 42%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 94%, transparent 100%);
  }

  .home-work-build-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .work-art-grid {
    opacity: 0.42;
    mask-image: radial-gradient(ellipse at 62% 50%, #000 12%, transparent 78%);
  }

  .work-art-idea {
    transform-origin: 145px 136px;
    animation: work-idea-drift 8s ease-in-out infinite;
  }

  .work-art-flow path:first-child {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: work-ribbon-draw 7s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-flow path:nth-child(2) {
    stroke-dasharray: 390;
    stroke-dashoffset: 390;
    animation: work-ribbon-draw 7s 0.7s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-flow path:nth-child(3) {
    stroke-dasharray: 280;
    stroke-dashoffset: 280;
    animation: work-ribbon-draw 7s 1.2s cubic-bezier(.65, 0, .25, 1) infinite;
  }

  .work-art-structure {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: work-structure-arrive 7s cubic-bezier(.2, .75, .2, 1) infinite;
  }

  .work-art-sparkles {
    animation: work-sparkle-breathe 4s ease-in-out infinite alternate;
  }

  .work-art-orbit {
    transform-box: fill-box;
    transform-origin: center;
    animation: work-orbit-turn 22s linear infinite;
  }

  @keyframes work-idea-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0); opacity: .8; }
    50% { transform: translate3d(5px, -5px, 0) rotate(3deg); opacity: 1; }
  }

  @keyframes work-ribbon-draw {
    0% { stroke-dashoffset: 420; opacity: .18; }
    38%, 78% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: -420; opacity: .2; }
  }

  @keyframes work-structure-arrive {
    0%, 12% { opacity: .18; transform: translate3d(0, 10px, 0) scale(.94); }
    42%, 82% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
    100% { opacity: .3; transform: translate3d(0, -3px, 0) scale(1.015); }
  }

  @keyframes work-sparkle-breathe {
    from { opacity: .45; }
    to { opacity: 1; }
  }

  @keyframes work-orbit-turn {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 48rem) {
    .home-work-build-visual {
      width: 100%;
      min-height: 0;
      aspect-ratio: 2.05 / 1;
      justify-self: stretch;
    }
  }

  @media (max-width: 36rem) {
    .home-work-build-visual {
      aspect-ratio: 1.8 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-art-idea,
    .work-art-flow path,
    .work-art-structure,
    .work-art-sparkles,
    .work-art-orbit {
      animation: none;
    }

    .work-art-flow path {
      stroke-dashoffset: 0;
    }
  }
</style>
