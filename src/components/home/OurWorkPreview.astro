---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="atmosphere" class="home-work-section">
  <section class="container container-wide home-work-content" aria-labelledby="home-work-title">
    <div class="home-work-heading">
      <div class="home-work-copy">
        <p class="eyebrow">OUR WORK</p>
        <h2 id="home-work-title">Ideas are easy. Building is the work.</h2>
        <p>
          From initiatives and partnerships to forums and fieldwork, everything we do is driven by
          one purpose: to turn conviction into real impact.
        </p>
      </div>
      <span class="home-work-index" aria-hidden="true">01 — 04 / IN ACTION</span>
    </div>

    <article class="home-work-feature" aria-labelledby="home-work-feature-title">
      <div class="home-work-feature-copy">
        <p class="home-work-feature-label"><span></span> FEATURED</p>
        <p class="home-work-feature-kicker">AI × FUTURE FORUM</p>
        <h3 id="home-work-feature-title">Shaping what&apos;s next.</h3>
        <p>
          Bringing together global leaders, educators, researchers, and innovators to explore how
          AI is redefining the future of learning and society.
        </p>
        <a class="home-work-feature-link" href="/our-work/#forums-events">
          View Highlights <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="home-work-feature-visual" aria-hidden="true">
        <div class="home-work-feature-orbit home-work-feature-orbit--outer"></div>
        <div class="home-work-feature-orbit home-work-feature-orbit--inner"></div>
        <div class="home-work-feature-core">
          <span>AI</span>
          <span>×</span>
          <span>FUTURE</span>
        </div>
        <span class="home-work-feature-coordinate home-work-feature-coordinate--top">LEARNING / SOCIETY</span>
        <span class="home-work-feature-coordinate home-work-feature-coordinate--bottom">IDEAS INTO ACTION</span>
        <span class="home-work-feature-node home-work-feature-node--one"></span>
        <span class="home-work-feature-node home-work-feature-node--two"></span>
        <span class="home-work-feature-node home-work-feature-node--three"></span>
      </div>
    </article>

    <ol class="home-work-categories" aria-label="Areas of work">
      <li>
        <span class="home-work-category-number">01</span>
        <div>
          <h3>Initiatives</h3>
          <p class="home-work-category-lead">We start what matters.</p>
          <p>Initiatives and programs we create to solve real problems and drive lasting change.</p>
        </div>
      </li>
      <li>
        <span class="home-work-category-number">02</span>
        <div>
          <h3>Partnerships</h3>
          <p class="home-work-category-lead">Stronger together.</p>
          <p>Collaborations with institutions, governments, universities, and organizations that amplify impact.</p>
        </div>
      </li>
      <li>
        <span class="home-work-category-number">03</span>
        <div>
          <h3>Forums &amp; Events</h3>
          <p class="home-work-category-lead">Conversations that build the future.</p>
          <p>Forums, summits, and events that spark dialogue, share knowledge, and shape the ecosystem.</p>
        </div>
      </li>
      <li>
        <span class="home-work-category-number">04</span>
        <div>
          <h3>In the Field</h3>
          <p class="home-work-category-lead">On the ground. In the real world.</p>
          <p>Workshops, visits, research, and engagements that keep us close to the problems we solve.</p>
        </div>
      </li>
    </ol>

    <div class="home-work-footer">
      <div>
        <p class="home-work-footer-title">Progress is built together.</p>
        <p>See more initiatives, partnerships, events, and moments from the field.</p>
      </div>
      <Button href="/our-work/" label="Explore Our Work" variant="inverse" />
    </div>
  </section>
</SectionWrapper>
