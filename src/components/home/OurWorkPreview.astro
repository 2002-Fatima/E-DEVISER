---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="atmosphere" class="home-work-section">
  <section class="container container-wide home-work-content" aria-labelledby="home-work-title">
    <header class="home-work-heading">
      <div class="home-work-copy">
        <p class="eyebrow">OUR WORK · A FIELD RECORD</p>
        <h2 id="home-work-title">Ideas are easy. Building is the work.</h2>
      </div>
      <p class="home-work-intro">
        A closer look at the initiatives, partnerships, conversations, and moments through which
        we put ideas into practice.
      </p>
    </header>

    <div class="home-work-editorial">
      <article class="home-work-feature" aria-labelledby="home-work-feature-title">
        <a class="home-work-feature-image" href="/our-work/#forums-events" aria-label="Explore the Forums and Events volume">
          <img
            src="/media/the-patriot-ai-future-summit.webp"
            alt="The Patriot AI Future Summit"
            loading="lazy"
            decoding="async"
          />
          <span class="home-work-feature-image-index">03 / 05</span>
          <span class="home-work-feature-image-mark" aria-hidden="true">E / D</span>
        </a>
        <div class="home-work-feature-copy">
          <div class="home-work-feature-meta">
            <span>FEATURED RECORD</span>
            <span>VOL. 03 — FORUMS &amp; EVENTS</span>
          </div>
          <h3 id="home-work-feature-title">Shaping what&apos;s next.</h3>
          <p>
            Public conversations create room to question, exchange perspectives, and explore
            what emerging technologies could mean for learning and society.
          </p>
          <a class="home-work-text-link" href="/our-work/#forums-events">
            Explore this volume <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <nav class="home-work-index" aria-label="Explore the five volumes of Our Work">
        <div class="home-work-index-heading">
          <p class="eyebrow">INSIDE THE COLLECTION</p>
          <p>Five volumes. One evolving record.</p>
        </div>
        <ol>
          <li>
            <a href="/our-work/#initiatives">
              <span class="home-work-index-number">01</span>
              <span class="home-work-index-copy">
                <strong>Initiatives</strong>
                <small>Creating spaces for what comes next</small>
              </span>
              <span class="home-work-index-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href="/our-work/#partnerships">
              <span class="home-work-index-number">02</span>
              <span class="home-work-index-copy">
                <strong>Partnerships</strong>
                <small>Connecting people and possibility</small>
              </span>
              <span class="home-work-index-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li class="is-featured">
            <a href="/our-work/#forums-events">
              <span class="home-work-index-number">03</span>
              <span class="home-work-index-copy">
                <strong>Forums &amp; Events</strong>
                <small>Making room for important conversations</small>
              </span>
              <span class="home-work-index-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href="/our-work/#in-the-field">
              <span class="home-work-index-number">04</span>
              <span class="home-work-index-copy">
                <strong>In the Field</strong>
                <small>Learning through presence and practice</small>
              </span>
              <span class="home-work-index-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href="/our-work/#recognition">
              <span class="home-work-index-number">05</span>
              <span class="home-work-index-copy">
                <strong>Recognition &amp; Features</strong>
                <small>Selected records and public recognition</small>
              </span>
              <span class="home-work-index-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        </ol>
        <p class="home-work-index-note">A selection from the wider work, documented as it develops.</p>
      </nav>
    </div>

    <footer class="home-work-footer">
      <div>
        <p class="home-work-footer-title">The work is still unfolding.</p>
        <p>Explore the full collection, from the first initiative to the latest field notes.</p>
      </div>
      <Button href="/our-work/" label="Explore Our Work" variant="primary" />
    </footer>
  </section>
</SectionWrapper>

<style>
  .home-work-section {
    border-block: 1px solid var(--color-border-inverse);
    overflow: clip;
  }

  .home-work-content {
    display: grid;
    gap: clamp(2.5rem, 5.5vw, 5rem);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .home-work-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, .65fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .home-work-copy {
    max-width: 58rem;
  }

  .home-work-copy h2 {
    max-width: 13ch;
    margin-block-start: .75rem;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.4vw, 5.3rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -.065em;
    line-height: .98;
  }

  .home-work-intro {
    max-width: 39ch;
    padding-block-end: .35rem;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .home-work-editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(19rem, .88fr);
    align-items: stretch;
    border: 1px solid rgba(220, 248, 246, .2);
    background: rgba(5, 21, 34, .34);
  }

  .home-work-feature {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border-inline-end: 1px solid rgba(220, 248, 246, .2);
  }

  .home-work-feature-image {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 1.45 / 1;
    background: var(--color-surface-night);
  }

  .home-work-feature-image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4, 17, 28, .32), transparent 34%, rgba(4, 17, 28, .22));
    content: "";
    pointer-events: none;
  }

  .home-work-feature-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--transition-interactive);
  }

  .home-work-feature-image:hover img {
    transform: scale(1.025);
  }

  .home-work-feature-image-index,
  .home-work-feature-image-mark {
    position: absolute;
    z-index: 1;
    top: 1rem;
    color: rgba(255, 255, 255, .9);
    font-family: var(--font-mono);
    font-size: .66rem;
    letter-spacing: .14em;
  }

  .home-work-feature-image-index { left: 1rem; }
  .home-work-feature-image-mark { right: 1rem; }

  .home-work-feature-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(.2rem, .8vw, .75rem) .5rem;
  }

  .home-work-feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1.25rem;
    color: var(--brand-teal-light);
    font-family: var(--font-mono);
    font-size: .62rem;
    letter-spacing: .12em;
    line-height: 1.6;
  }

  .home-work-feature-copy h3 {
    margin-block: 1rem .75rem;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -.055em;
    line-height: 1;
  }

  .home-work-feature-copy > p:not(.home-work-feature-meta) {
    max-width: 48ch;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .home-work-text-link {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    margin-block-start: 1.35rem;
    padding-block-end: .3rem;
    border-block-end: 1px solid rgba(143, 233, 220, .45);
    color: var(--color-white);
    font-size: .82rem;
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: color var(--transition-interactive), border-color var(--transition-interactive);
  }

  .home-work-text-link span {
    color: var(--brand-teal-light);
    transition: transform var(--transition-interactive);
  }

  .home-work-text-link:hover { color: var(--brand-teal-light); border-color: var(--brand-teal-light); }
  .home-work-text-link:hover span { transform: translate(2px, -2px); }

  .home-work-index {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.4rem, 3vw, 2.5rem);
  }

  .home-work-index-heading {
    padding-block-end: 1.35rem;
    border-block-end: 1px solid rgba(220, 248, 246, .2);
  }

  .home-work-index-heading .eyebrow {
    color: var(--brand-teal-light);
  }

  .home-work-index-heading > p:last-child {
    margin-block-start: .55rem;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-sm);
  }

  .home-work-index ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-work-index li {
    border-block-end: 1px solid rgba(220, 248, 246, .16);
  }

  .home-work-index li a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: .8rem;
    min-height: 5.1rem;
    padding-block: .85rem;
    color: inherit;
    text-decoration: none;
    transition: background var(--transition-interactive), padding var(--transition-interactive);
  }

  .home-work-index li a:hover {
    padding-inline: .55rem;
    background: rgba(143, 233, 220, .055);
  }

  .home-work-index-number {
    align-self: start;
    padding-block-start: .2rem;
    color: var(--brand-teal-light);
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .08em;
  }

  .home-work-index-copy {
    display: grid;
    gap: .28rem;
    min-width: 0;
  }

  .home-work-index-copy strong {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(.95rem, 1.25vw, 1.08rem);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .home-work-index-copy small {
    color: var(--color-text-inverse-subtle);
    font-size: .76rem;
    line-height: 1.45;
  }

  .home-work-index-arrow {
    color: var(--color-text-inverse-subtle);
    font-size: 1rem;
    transition: color var(--transition-interactive), transform var(--transition-interactive);
  }

  .home-work-index li a:hover .home-work-index-arrow {
    color: var(--brand-teal-light);
    transform: translate(2px, -2px);
  }

  .home-work-index li.is-featured {
    margin-inline: -.55rem;
    padding-inline: .55rem;
    border-inline-start: 2px solid var(--brand-teal);
    background: rgba(143, 233, 220, .055);
  }

  .home-work-index-note {
    margin-block-start: auto;
    padding-block-start: 1.25rem;
    color: var(--color-text-inverse-subtle);
    font-size: .72rem;
    line-height: 1.6;
  }

  .home-work-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block-start: clamp(1.5rem, 3vw, 2.25rem);
    border-block-start: 1px solid rgba(220, 248, 246, .2);
  }

  .home-work-footer-title {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -.03em;
  }

  .home-work-footer > div > p:last-child {
    margin-block-start: .35rem;
    color: var(--color-text-inverse-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .home-work-section a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }

  @media (max-width: 62rem) {
    .home-work-heading {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .home-work-copy h2 { max-width: 16ch; }
    .home-work-editorial { grid-template-columns: minmax(0, 1fr) minmax(17rem, .9fr); }
    .home-work-feature-meta { gap: .45rem .8rem; }
  }

  @media (max-width: 48rem) {
    .home-work-content { gap: 2rem; }
    .home-work-editorial { grid-template-columns: 1fr; }
    .home-work-feature { border-inline-end: 0; border-block-end: 1px solid rgba(220, 248, 246, .2); }
    .home-work-feature-image { aspect-ratio: 1.5 / 1; }
    .home-work-index { padding: 1.35rem 1.2rem 1.5rem; }
    .home-work-index li a { min-height: 4.7rem; }
    .home-work-footer { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 36rem) {
    .home-work-content { padding-block: 3.5rem; }
    .home-work-copy h2 { font-size: clamp(2.45rem, 11vw, 3.6rem); }
    .home-work-intro { font-size: var(--text-base); }
    .home-work-feature { padding: .7rem; }
    .home-work-feature-image { aspect-ratio: 1.2 / 1; }
    .home-work-feature-copy { padding: 1.25rem .35rem .35rem; }
    .home-work-feature-meta { flex-direction: column; gap: .25rem; }
    .home-work-index { padding-inline: 1rem; }
    .home-work-index li a { grid-template-columns: 1.65rem minmax(0, 1fr) auto; gap: .6rem; }
    .home-work-index-copy small { font-size: .72rem; }
    .home-work-footer { gap: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-work-feature-image img,
    .home-work-text-link,
    .home-work-text-link span,
    .home-work-index li a,
    .home-work-index-arrow { transition: none; }
    .home-work-feature-image:hover img { transform: none; }
  }
</style>
