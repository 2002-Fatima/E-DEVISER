<div class="mission-globe-field" data-mission-globe role="img" aria-label="An animated globe highlighting the six GCC countries, with luminous pathways connecting the region">
  <canvas class="mission-globe-canvas" data-mission-globe-canvas aria-hidden="true"></canvas>
  <div class="mission-globe-vignette" aria-hidden="true"></div>
  <span class="mission-globe-coordinate mission-globe-coordinate--top" aria-hidden="true">26°N · 50°E</span>
  <span class="mission-globe-coordinate mission-globe-coordinate--bottom" aria-hidden="true">CONNECTED BY POSSIBILITY</span>
  <span class="mission-globe-label mission-globe-label--sa" aria-hidden="true">SAUDI ARABIA</span>
  <span class="mission-globe-label mission-globe-label--qa" aria-hidden="true">QATAR</span>
  <span class="mission-globe-label mission-globe-label--ae" aria-hidden="true">UAE</span>
  <span class="mission-globe-label mission-globe-label--om" aria-hidden="true">OMAN</span>
  <span class="mission-globe-label mission-globe-label--kw" aria-hidden="true">KUWAIT</span>
  <span class="mission-globe-label mission-globe-label--bh" aria-hidden="true">BAHRAIN</span>
  <div class="mission-globe-orbit-tag mission-globe-orbit-tag--one" aria-hidden="true"><span></span> LEARNING</div>
  <div class="mission-globe-orbit-tag mission-globe-orbit-tag--two" aria-hidden="true"><span></span> INTELLIGENCE</div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-mission-globe]').forEach((field) => {
    const canvas = field.querySelector<HTMLCanvasElement>('[data-mission-globe-canvas]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const countries = [
      { name: 'SAUDI ARABIA', lat: 24.7, lon: 46.7 },
      { name: 'KUWAIT', lat: 29.3, lon: 47.5 },
      { name: 'BAHRAIN', lat: 26.1, lon: 50.6 },
      { name: 'QATAR', lat: 25.3, lon: 51.5 },
      { name: 'UAE', lat: 24.4, lon: 54.4 },
      { name: 'OMAN', lat: 23.6, lon: 58.5 },
    ];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let dpr = 1;
    let elapsed = 0;
    let frame = 0;
    let lastFrame = 0;
    let visible = true;
    let disposed = false;

    const project = (lat: number, lon: number, cx: number, cy: number, radius: number, rotation: number) => {
      const phi = (lat * Math.PI) / 180;
      const lambda = ((lon - 30 + rotation) * Math.PI) / 180;
      const x = Math.cos(phi) * Math.sin(lambda);
      const y = -Math.sin(phi);
      const z = Math.cos(phi) * Math.cos(lambda);
      return { x: cx + x * radius, y: cy + y * radius, z };
    };

    const resize = () => {
      const rect = field.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 1.7);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };

    const glowDot = (x: number, y: number, radius: number, color: string, blur: number) => {
      ctx.save();
      ctx.shadowColor = color;
      ctx.shadowBlur = blur;
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const draw = () => {
      if (!width || !height) return;
      ctx.clearRect(0, 0, width, height);
      const cx = width * 0.51;
      const cy = height * 0.51;
      const radius = Math.min(width * 0.37, height * 0.405);
      const rotation = Math.sin(elapsed * 0.075) * 2.5;

      const atmosphere = ctx.createRadialGradient(cx, cy, radius * 0.45, cx, cy, radius * 1.5);
      atmosphere.addColorStop(0, 'rgba(3, 130, 189, 0.13)');
      atmosphere.addColorStop(0.55, 'rgba(32, 183, 207, 0.075)');
      atmosphere.addColorStop(1, 'rgba(32, 183, 207, 0)');
      ctx.fillStyle = atmosphere;
      ctx.beginPath();
      ctx.arc(cx, cy, radius * 1.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.clip();
      const sphere = ctx.createRadialGradient(cx - radius * 0.35, cy - radius * 0.38, radius * 0.04, cx, cy, radius * 1.22);
      sphere.addColorStop(0, 'rgba(31, 132, 169, 0.2)');
      sphere.addColorStop(0.55, 'rgba(9, 49, 74, 0.1)');
      sphere.addColorStop(1, 'rgba(3, 25, 43, 0.03)');
      ctx.fillStyle = sphere;
      ctx.fillRect(cx - radius, cy - radius, radius * 2, radius * 2);

      ctx.lineWidth = 0.7;
      for (let i = -3; i <= 3; i += 1) {
        const y = cy + (i / 4) * radius;
        const rx = radius * Math.sqrt(Math.max(0, 1 - (i / 4) ** 2));
        ctx.beginPath();
        ctx.ellipse(cx, y, rx, Math.max(2, radius * 0.105), 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(75, 185, 204, 0.2)';
        ctx.stroke();
      }
      for (let i = 0; i < 7; i += 1) {
        const offset = (i - 3) / 3;
        const rx = Math.max(3, radius * Math.abs(offset));
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, radius, 0, 0, Math.PI * 2);
        ctx.strokeStyle = i === 3 ? 'rgba(112, 225, 222, 0.22)' : 'rgba(75, 185, 204, 0.14)';
        ctx.stroke();
      }

      // Subtle continental silhouettes, built from softly lit geographic point clusters.
      const landGroups = [
        { lat: 37, lon: 10, spread: 0.18 },
        { lat: 8, lon: 24, spread: 0.16 },
        { lat: 48, lon: 72, spread: 0.2 },
        { lat: -18, lon: 134, spread: 0.13 },
        { lat: 42, lon: -102, spread: 0.18 },
        { lat: -14, lon: -62, spread: 0.15 },
      ];
      for (const land of landGroups) {
        for (let i = 0; i < 52; i += 1) {
          const a = i * 2.399;
          const spread = land.spread * Math.sqrt(i / 52);
          const point = project(land.lat + Math.cos(a) * spread * 55, land.lon + Math.sin(a) * spread * 65, cx, cy, radius, rotation);
          if (point.z > 0) glowDot(point.x, point.y, 0.55 + (i % 4) * 0.13, 'rgba(93, 191, 190, 0.3)', 2);
        }
      }

      // GCC origins and converging light paths.
      const target = project(25, 50, cx, cy, radius, rotation);
      countries.forEach((country, index) => {
        const point = project(country.lat, country.lon, cx, cy, radius, rotation);
        if (point.z <= 0) return;
        const pulse = 0.5 + (Math.sin(elapsed * 1.1 + index * 1.3) + 1) * 0.25;
        const lift = radius * (0.16 + (index % 3) * 0.045);
        const startX = point.x;
        const startY = point.y;
        const endX = target.x + Math.cos(index * 2.2) * radius * 0.035;
        const endY = target.y + Math.sin(index * 2.2) * radius * 0.035;

        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        ctx.beginPath();
        ctx.moveTo(startX, startY);
        ctx.bezierCurveTo(
          startX + (endX - startX) * 0.25,
          startY - lift,
          endX - (endX - startX) * 0.25,
          endY - lift * 0.55,
          endX,
          endY,
        );
        const path = ctx.createLinearGradient(startX, startY, endX, endY);
        path.addColorStop(0, 'rgba(25, 160, 202, 0.04)');
        path.addColorStop(0.45, 'rgba(45, 210, 219, 0.68)');
        path.addColorStop(1, 'rgba(225, 255, 248, 0.94)');
        ctx.strokeStyle = path;
        ctx.lineWidth = 0.8 + pulse * 0.65;
        ctx.shadowColor = 'rgba(63, 227, 221, 0.72)';
        ctx.shadowBlur = 9 + pulse * 7;
        ctx.stroke();

        const travel = (elapsed * (0.19 + index * 0.012) + index / countries.length) % 1;
        const t = travel;
        const inv = 1 - t;
        const px = inv ** 3 * startX + 3 * inv ** 2 * t * (startX + (endX - startX) * 0.25) + 3 * inv * t ** 2 * (endX - (endX - startX) * 0.25) + t ** 3 * endX;
        const py = inv ** 3 * startY + 3 * inv ** 2 * t * (startY - lift) + 3 * inv * t ** 2 * (endY - lift * 0.55) + t ** 3 * endY;
        glowDot(px, py, 1.35, 'rgba(230, 255, 248, 0.98)', 10);
        glowDot(startX, startY, 2.2 + pulse * 0.8, 'rgba(91, 244, 225, 0.98)', 12);
        ctx.restore();
      });

      // Soft focal point where regional pathways meet.
      const core = ctx.createRadialGradient(target.x, target.y, 0, target.x, target.y, radius * 0.2);
      core.addColorStop(0, 'rgba(226, 255, 249, 0.48)');
      core.addColorStop(0.12, 'rgba(68, 226, 216, 0.2)');
      core.addColorStop(1, 'rgba(3, 130, 189, 0)');
      ctx.fillStyle = core;
      ctx.beginPath();
      ctx.arc(target.x, target.y, radius * 0.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(80, 194, 211, 0.42)';
      ctx.lineWidth = 1;
      ctx.shadowColor = 'rgba(47, 198, 216, 0.45)';
      ctx.shadowBlur = 15;
      ctx.stroke();
      ctx.shadowBlur = 0;

      // Fine orbit arcs reinforce the morphic, connected-systems language.
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(-0.24 + Math.sin(elapsed * 0.08) * 0.025);
      ctx.beginPath();
      ctx.ellipse(0, 0, radius * 1.16, radius * 0.38, 0, Math.PI * 0.08, Math.PI * 1.92);
      ctx.strokeStyle = 'rgba(3, 130, 189, 0.22)';
      ctx.lineWidth = 0.8;
      ctx.stroke();
      ctx.restore();
    };

    const animate = (time: number) => {
      frame = 0;
      if (disposed || !visible || document.hidden || reducedMotion.matches) return;
      if (time - lastFrame > 32) {
        elapsed += Math.min(64, lastFrame ? time - lastFrame : 32) / 1000;
        lastFrame = time;
        draw();
      }
      frame = requestAnimationFrame(animate);
    };
    const sync = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      lastFrame = 0;
      if (reducedMotion.matches || document.hidden || !visible) {
        draw();
        return;
      }
      frame = requestAnimationFrame(animate);
    };

    const resizeObserver = new ResizeObserver(resize);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    });
    resizeObserver.observe(field);
    intersectionObserver.observe(field);
    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    resize();
    sync();

    const cleanup = () => {
      disposed = true;
      if (frame) cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      document.removeEventListener('visibilitychange', sync);
      reducedMotion.removeEventListener('change', sync);
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
