---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
import MethodologyFlow from '../what-we-build/MethodologyFlow.astro';
---

<SectionWrapper background="atmosphere" class="home-methodology-section">
  <section class="container container-wide" aria-labelledby="home-methodology-title">
    <header class="home-methodology-heading">
      <p class="eyebrow">WHAT WE BUILD</p>
      <h2 id="home-methodology-title">We turn complex problems<br />into <span>intelligent solutions.</span></h2>
      <p>
        E Deviser brings together technology, domain knowledge, and problem-solving to build
        solutions for challenges that don&apos;t have simple answers.
      </p>
    </header>

    <MethodologyFlow />

    <div class="home-methodology-action">
      <Button href="/what-we-build/" label="Explore What We Build" />
    </div>
  </section>
</SectionWrapper>
