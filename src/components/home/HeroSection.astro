---
import Button from '../ui/Button.astro';
import HeroTransformation from '../ui/HeroTransformation.astro';
import IntelligenceField from './IntelligenceField.astro';
---

<section class="hero-section home-hero">
  <div class="container home-hero-shell">
    <div class="home-hero-copy">
      <p class="eyebrow home-hero-brand">E DEVISER</p>
      <p class="home-hero-kicker">WE BUILD AGENTIC INTELLIGENT SYSTEMS FOR</p>
      <h1>
        <span class="home-hero-line home-hero-line--primary">COMPLEX</span>
        <span class="home-hero-line home-hero-line--accent text-gradient">
          <HeroTransformation inline />
          <span aria-hidden="true">.</span>
        </span>
      </h1>
      <p class="lede">
        E Deviser combines AI, data, and domain intelligence to solve complex problems — today,
        we&apos;re building deeply in education.
      </p>
      <div class="hero-actions button-context-dark">
        <Button href="/what-we-build/" label="Explore What We Build" />
        <Button href="https://cuovo.tech/" external label="Explore CUOVO" variant="secondary" />
      </div>
    </div>

    <IntelligenceField />
  </div>
</section>
