---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="light" class="home-founder-section">
  <section class="container container-wide home-founder-layout" aria-labelledby="home-founder-title">
    <div class="home-founder-copy">
      <p class="eyebrow">FOUNDER INTRODUCTION</p>
      <h2 id="home-founder-title">Why we&apos;re building E Deviser</h2>
      <p>We believe the hardest problems deserve better intelligence.</p>
      <p class="home-founder-note">
        A personal introduction from our founder is being prepared. Until then, explore the thinking
        behind what we build.
      </p>
      <Button href="/company/story/" label="Meet E Deviser" variant="outline" />
    </div>

    <figure class="home-founder-media">
      <div class="home-founder-media-frame" aria-label="Founder video introduction coming soon">
        <span class="home-founder-media-index" aria-hidden="true">E / D</span>
        <div class="home-founder-media-orbit home-founder-media-orbit--one" aria-hidden="true"></div>
        <div class="home-founder-media-orbit home-founder-media-orbit--two" aria-hidden="true"></div>
        <div class="home-founder-media-status">
          <span class="home-founder-monogram" aria-hidden="true">E<span>/</span>D</span>
          <p>A message from the founder</p>
          <small>Video introduction coming soon</small>
        </div>
        <span class="home-founder-media-caption" aria-hidden="true">Founder perspective · Coming soon</span>
      </div>
      <figcaption class="sr-only">
        The founder video introduction is not yet available. This is a placeholder and does not contain playback.
      </figcaption>
    </figure>
  </section>
</SectionWrapper>
