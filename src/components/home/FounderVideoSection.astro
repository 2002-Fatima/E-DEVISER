---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="light" class="home-founder-section">
  <section class="container container-wide home-founder-layout" aria-labelledby="home-founder-title">
    <div class="home-founder-copy">
      <p class="eyebrow home-founder-eyebrow"><span aria-hidden="true"></span> THE CONVICTION BEHIND EDEVISER</p>
      <h2 id="home-founder-title">Progress begins with <span>people.</span></h2>
      <p class="home-founder-lead">We believe the hardest problems deserve better intelligence.</p>
      <p class="home-founder-note">
        EDEviser brings human understanding and intelligent technology together to solve problems
        that matter — and turn better thinking into meaningful outcomes.
      </p>

      <ol class="home-founder-principles" aria-label="Our founding principles">
        <li><span>01</span><strong>Start with people</strong></li>
        <li><span>02</span><strong>Think beyond the obvious</strong></li>
        <li><span>03</span><strong>Build for real impact</strong></li>
      </ol>

      <div class="home-founder-actions">
        <Button href="/company/story/" label="Meet E Deviser" variant="primary" />
        <span class="home-founder-action-note">Explore our story and purpose</span>
      </div>
    </div>

    <figure class="home-founder-media">
      <div class="home-founder-video-frame" aria-label="Founder video introduction coming soon">
        <div class="home-founder-video-placeholder">
          <span class="home-founder-video-kicker">A MESSAGE FROM OUR FOUNDER</span>
          <span class="home-founder-video-title">The story behind<br />the work.</span>
          <span class="home-founder-video-caption">Founder film · Coming soon</span>
        </div>
      </div>
      <figcaption class="sr-only">
        Reserved space for the founder video introduction. Video playback will be added when the approved film is available.
      </figcaption>
    </figure>
  </section>
</SectionWrapper>
