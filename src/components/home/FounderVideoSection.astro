---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="light" class="home-founder-section">
  <section class="container container-wide home-founder-layout" aria-labelledby="home-founder-title">
    <div class="home-founder-copy">
      <p class="eyebrow">FOUNDER INTRODUCTION</p>
      <h2 id="home-founder-title">Why we&apos;re building E Deviser</h2>
      <p>We believe the hardest problems deserve better intelligence.</p>
      <Button href="/company/story/" label="Meet E Deviser" variant="outline" />
    </div>

    <figure class="home-founder-media">
      <div class="home-founder-media-frame">
        <span class="home-founder-media-index" aria-hidden="true">E / D</span>
        <div class="home-founder-media-status">
          <span class="home-media-indicator" aria-hidden="true"></span>
          <p>Founder introduction</p>
          <small>No approved founder video is available yet.</small>
        </div>
        <span class="home-founder-media-caption" aria-hidden="true">Founder introduction · 60–90 seconds</span>
      </div>
      <figcaption class="sr-only">
        Founder introduction video is not yet available. No playback control is shown.
      </figcaption>
    </figure>
  </section>
</SectionWrapper>
