---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper>
  <div class="container founder-video-wrap">
    <div class="section-header-inline">
      <div>
        <p class="eyebrow">FOUNDER VIDEO</p>
        <h2>Context and perspective</h2>
      </div>
    </div>
    <div class="video-placeholder" aria-label="Founder video placeholder">
      <div class="video-placeholder-inner">
        <span class="play-button" aria-hidden="true">▶</span>
        <p>Founder studio video placeholder</p>
        <small>No approved video asset has been supplied for this section.</small>
      </div>
    </div>
  </div>
</SectionWrapper>
