---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="light" class="home-cuevo-section">
  <section class="container container-wide home-cuevo-layout" aria-labelledby="home-cuevo-title">
    <div class="home-cuevo-visual">
      <div class="cuevo-product-stage">
        <div class="cuevo-product-meta">
          <span class="cuevo-product-wordmark">CUEVO <i aria-hidden="true">/</i> STUDENT EXPERIENCE</span>
          <span class="cuevo-product-state">PRODUCT PREVIEW</span>
        </div>

        <figure class="cuevo-dashboard">
          <img
            src="/product/cuevo/student-dashboard.webp"
            alt="Preview of the Cuevo student dashboard"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="cuevo-stage-caption">
          <span>AN EDUCATION-FOCUSED INITIATIVE</span>
          <span>BY E DEVISER</span>
        </div>
      </div>

      <div class="cuevo-foundations" aria-label="Cuevo's guiding foundations">
        <div><span>01</span><strong>Outcome-based education</strong></div>
        <div><span>02</span><strong>Meaningful gamification</strong></div>
        <div><span>03</span><strong>Agentic AI</strong></div>
      </div>
    </div>

    <div class="home-cuevo-copy cuevo-story-copy">
      <p class="eyebrow">WHAT WE&apos;RE BUILDING TODAY <span class="cuevo-section-index">/ 04</span></p>
      <p class="cuevo-overline">MEET CUEVO</p>
      <h2 id="home-cuevo-title">Make learning visible. <span>Make progress meaningful.</span></h2>
      <p class="cuevo-story-lede">
        Cuevo is E Deviser&apos;s education-focused initiative, shaped around outcome-based education,
        meaningful gamification, and the possibilities of agentic AI.
      </p>
      <div class="cuevo-story-divider" aria-hidden="true"></div>
      <p class="home-cuevo-support">Designed with the wider learning community in mind.</p>
      <ul class="home-cuevo-roles" aria-label="People in the Cuevo learning community">
        <li>Admin</li>
        <li>Coordinator</li>
        <li>Teacher</li>
        <li>Student</li>
        <li>Parent</li>
      </ul>
      <div class="cuevo-story-action">
        <Button href="https://cuevo.tech/" external label="Explore Cuevo" />
        <span>A CLOSER LOOK AT WHAT&apos;S TAKING SHAPE</span>
      </div>
    </div>
  </section>
</SectionWrapper>
