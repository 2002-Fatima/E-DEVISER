---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Button from '../ui/Button.astro';
---

<SectionWrapper background="light background-pattern" class="home-cuevo-section">
  <section class="container container-wide home-cuevo-layout" aria-labelledby="home-cuevo-title">
    <div class="home-cuevo-mark-wrap">
      <img src="/brand/cuevo-mark.png" alt="CUOVO product mark" width="300" height="300" loading="lazy" />
      <span class="home-cuevo-mark-caption">BUILT BY E DEVISER</span>
    </div>

    <div class="home-cuevo-copy">
      <p class="eyebrow">WHAT WE&apos;RE BUILDING TODAY</p>
      <h2 id="home-cuevo-title">Our first deep dive: learning.</h2>
      <p>
        CUOVO is E Deviser&apos;s learning-intelligence platform, built to help education understand
        learning more deeply and act on what it learns.
      </p>
      <p class="home-cuevo-support">Built by E Deviser. Designed for the complexity of learning.</p>
      <Button href="https://cuovo.tech/" external label="Explore CUOVO" />
    </div>
  </section>
</SectionWrapper>
