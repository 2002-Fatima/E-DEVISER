---
import PrimaryNavigation from '../navigation/PrimaryNavigation.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="E Deviser home">
      <span class="brand-mark">E</span>
      <span class="brand-word">E Deviser</span>
    </a>

    <div class="desktop-nav">
      <PrimaryNavigation />
    </div>

    <button
      class="mobile-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Toggle navigation"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-navigation" id="mobile-navigation" hidden>
    <div class="container">
      <PrimaryNavigation />
    </div>
  </div>
</header>

<script>
  import '../../scripts/mobile-navigation';
</script>
