---
import PrimaryNavigation from '../navigation/PrimaryNavigation.astro';
import Button from '../ui/Button.astro';
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src="/brand/edeviser-mark.png" alt="E Deviser mark" width="837" height="420" />
      <span class="brand-word">E Deviser</span>
    </a>

    <div class="desktop-nav">
      <PrimaryNavigation />
    </div>

    <div class="header-actions">
      <Button href="/company/careers-contact/" label="Let's Talk" size="sm" class="header-cta" />
      <button
        class="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Open navigation"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-navigation" id="mobile-navigation" hidden>
    <div class="container">
      <PrimaryNavigation label="Mobile navigation" />
      <Button href="/company/careers-contact/" label="Let's Talk" size="md" class="mobile-talk-cta" />
    </div>
  </div>
</header>

<script>
  import '../../scripts/mobile-navigation';
</script>
