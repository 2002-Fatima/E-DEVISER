---
const { items = [], class: className = '' } = Astro.props;
---
{items.length > 0 && (
  <div class:list={["section-nav-wrap", className]}>
    <nav class="section-nav" aria-label="Section navigation">
      <ul class="section-nav-list">
        {items.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
)}
