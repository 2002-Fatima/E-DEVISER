---
interface Option {
  label: string;
  value: string;
  disabled?: boolean;
}

interface Props {
  id?: string;
  name: string;
  label: string;
  options: Option[];
  value?: string;
  placeholder?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
}

const {
  id = Astro.props.name,
  name,
  label,
  options,
  value,
  placeholder,
  hint,
  error,
  required = false,
  disabled = false,
} = Astro.props;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const describedBy = [hint && hintId, error && errorId].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label class="field-label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <select
    class="field-control"
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
  >
    {placeholder && <option value="" selected={!value} disabled={required}>{placeholder}</option>}
    {options.map((option) => (
      <option value={option.value} selected={option.value === value} disabled={option.disabled}>{option.label}</option>
    ))}
  </select>
  {hint && <span class="field-hint" id={hintId}>{hint}</span>}
  {error && <span class="field-error" id={errorId} role="alert">{error}</span>}
</div>
