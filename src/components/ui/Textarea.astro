---
interface Props {
  id?: string;
  name: string;
  label: string;
  value?: string;
  placeholder?: string;
  hint?: string;
  error?: string;
  rows?: number;
  required?: boolean;
  disabled?: boolean;
}

const {
  id = Astro.props.name,
  name,
  label,
  value,
  placeholder,
  hint,
  error,
  rows = 4,
  required = false,
  disabled = false,
} = Astro.props;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const describedBy = [hint && hintId, error && errorId].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label class="field-label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <textarea
    class="field-control"
    id={id}
    name={name}
    rows={rows}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
  >{value}</textarea>
  {hint && <span class="field-hint" id={hintId}>{hint}</span>}
  {error && <span class="field-error" id={errorId} role="alert">{error}</span>}
</div>
