---
interface Props {
  orientation?: 'horizontal' | 'vertical';
  label?: string;
  class?: string;
}

const { orientation = 'horizontal', label, class: className = '' } = Astro.props;
---

{orientation === 'vertical' ? (
  <span class:list={['divider', 'divider-vertical', className]} role="separator" aria-orientation="vertical" aria-label={label}></span>
) : (
  <hr class:list={['divider', className]} aria-label={label} />
)}
