<main class="cc-page">
  <section class="cc-hero">
    <div class="cc-wrap cc-hero-grid">
      <div>
        <p class="cc-kicker"><span></span> CAREERS &amp; CONTACT</p>
        <h1>Good work starts<br/>with a <em>conversation.</em></h1>
        <p class="cc-lead">We are building E Deviser around important problems, thoughtful people, and the determination to turn better intelligence into meaningful change.</p>
        <a class="cc-primary-link" href="#contact">Find your way to us <span>↓</span></a>
      </div>
      <div class="cc-hero-art" role="img" aria-label="An illuminated connection point representing the start of a new conversation">
        <div class="cc-art-grid"></div><div class="cc-art-ring cc-ring-one"></div><div class="cc-art-ring cc-ring-two"></div><div class="cc-art-ring cc-ring-three"></div>
        <div class="cc-art-core"><span>START WITH</span><b>A QUESTION</b><i></i></div>
        <span class="cc-art-tag cc-tag-one">IDEAS</span><span class="cc-art-tag cc-tag-two">PEOPLE</span><span class="cc-art-tag cc-tag-three">POSSIBILITY</span>
        <small>OPEN TO WHAT MATTERS</small>
      </div>
    </div>
    <div class="cc-wrap cc-hero-foot"><span>THOUGHTFUL CONVERSATIONS</span><i></i><span>MEANINGFUL WORK</span><i></i><span>REAL PROGRESS</span></div>
  </section>

  <section class="cc-section cc-careers" id="careers">
    <div class="cc-wrap">
      <div class="cc-section-head">
        <p class="cc-kicker">CAREERS AT E DEVİSER</p>
        <h2>For people who want to <em>go deeper.</em></h2>
        <p>We value people who can move between ideas and execution—people who don't just ask what is possible, but what is worth doing.</p>
      </div>
      <div class="cc-career-panel">
        <div class="cc-career-symbol"><span> E. </span><i></i></div>
        <div class="cc-career-copy"><small>OPPORTUNITIES</small><h3>Build with curiosity.<br/><em>Work with intention.</em></h3><p>Career openings are not currently published on this page. When roles are confirmed, this is where the details will appear.</p><a href="/company/team/">Understand the people and principles behind the work <span>↗</span></a></div>
        <div class="cc-career-status"><i></i> NO LISTED OPENINGS</div>
      </div>
    </div>
  </section>

  <section class="cc-section cc-contact" id="contact">
    <div class="cc-wrap cc-contact-grid">
      <div class="cc-contact-intro">
        <p class="cc-kicker">GET IN TOUCH</p>
        <h2>Have something <em>worth exploring?</em></h2>
        <p>Whether you have a problem to solve, an idea to discuss, or want to learn more about E Deviser, start with what you are working on.</p>
      </div>
      <div class="cc-contact-card">
        <span class="cc-card-index">01 / START A CONVERSATION</span>
        <div class="cc-card-orb"><i></i></div>
        <h3>Let's talk about<br/><em>what matters.</em></h3>
        <p>Our public contact details are not yet published. We have kept this page clear rather than displaying an unverified email address or a form that does not send anywhere.</p>
        <a href="/company/">Explore E Deviser <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="cc-next">
    <div class="cc-wrap cc-next-inner">
      <div><p class="cc-kicker">GET TO KNOW US</p><h2>See what we're <em>building.</em></h2></div>
      <div class="cc-next-links"><a href="/what-we-build/">What We Build <span>↗</span></a><a href="/our-work/">Our Work <span>↗</span></a><a href="/company/team/">Meet the Team <span>↗</span></a></div>
    </div>
  </section>
</main>

<style>
.cc-page{--cc-bg:#07121d;--cc-panel:#0c1c29;--cc-line:rgba(160,205,218,.16);--cc-text:#f4f8fa;--cc-muted:#a8bac5;--cc-blue:#0382BD;--cc-teal:#5AB9B4;--cc-mint:#CDFCF4;background:var(--cc-bg);color:var(--cc-text);overflow:hidden}
.cc-page *{box-sizing:border-box}.cc-wrap{width:min(88rem,calc(100% - 3rem));margin-inline:auto}
.cc-kicker{display:flex;align-items:center;gap:.7rem;margin:0 0 1.5rem;color:#83d2d0;font:600 .64rem/1.4 var(--font-mono,monospace);letter-spacing:.16em}.cc-kicker>span{width:.42rem;height:.42rem;border-radius:50%;background:var(--cc-teal);box-shadow:0 0 13px #5ab9b4a6}
.cc-hero{padding:clamp(4rem,8vw,7.5rem) 0 2rem;background:radial-gradient(ellipse at 78% 35%,rgba(3,130,189,.17),transparent 39%),linear-gradient(180deg,#081622,#07121d)}
.cc-hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(25rem,1.1fr);gap:clamp(2rem,6vw,6rem);align-items:center;min-height:34rem}
.cc-hero h1,.cc-section h2,.cc-next h2{margin:0;color:var(--cc-text);font:700 clamp(3rem,5.7vw,5.9rem)/.98 var(--font-display,var(--font-body,sans-serif));letter-spacing:-.065em}
.cc-hero h1 em,.cc-section h2 em,.cc-next h2 em,.cc-career-copy h3 em,.cc-contact-card h3 em{color:#76cbc9;font-style:normal}
.cc-lead{max-width:38rem;margin:1.6rem 0 0;color:var(--cc-muted);font-size:clamp(1rem,1.3vw,1.15rem);line-height:1.85}
.cc-primary-link{display:inline-flex;align-items:center;gap:1.3rem;margin-top:2rem;color:#c0e2fd;text-decoration:none;font-size:.85rem;font-weight:650}.cc-primary-link span{color:var(--cc-teal)}
.cc-hero-art{position:relative;min-height:31rem;overflow:hidden;border:1px solid var(--cc-line);background:radial-gradient(ellipse at 50% 48%,rgba(3,130,189,.2),transparent 43%),linear-gradient(145deg,#0c2230,#081522 65%,#0b1d28)}
.cc-art-grid{position:absolute;inset:0;opacity:.24;background-image:linear-gradient(rgba(192,226,253,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(192,226,253,.08) 1px,transparent 1px);background-size:42px 42px;mask-image:radial-gradient(ellipse at center,#000 20%,transparent 78%)}
.cc-art-ring{position:absolute;left:50%;top:48%;width:19rem;height:19rem;border:1px solid rgba(90,185,180,.32);border-radius:50%;transform:translate(-50%,-50%) rotate(-28deg) scaleY(.48)}
.cc-ring-two{width:24rem;height:24rem;transform:translate(-50%,-50%) rotate(58deg) scaleY(.48);border-color:rgba(3,130,189,.5)}
.cc-ring-three{width:29rem;height:29rem;transform:translate(-50%,-50%) rotate(-62deg) scaleY(.48);border-color:rgba(192,226,253,.22)}
.cc-art-core{position:absolute;left:50%;top:48%;width:12rem;height:12rem;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.55rem;border:1px solid rgba(192,226,253,.38);border-radius:45% 55% 52% 48%/48% 42% 58% 52%;background:radial-gradient(circle at 35% 28%,rgba(90,185,180,.28),transparent 55%),rgba(7,24,36,.94);box-shadow:0 0 70px rgba(3,130,189,.2),inset 0 0 35px rgba(90,185,180,.09);transform:translate(-50%,-50%);animation:cc-morph 12s ease-in-out infinite alternate}
.cc-art-core span,.cc-art-core b{font-family:var(--font-mono,monospace);letter-spacing:.14em}.cc-art-core span{font-size:.56rem;color:#9bbfc9}.cc-art-core b{font-size:1.1rem;color:white}.cc-art-core i{width:2.3rem;height:1px;background:linear-gradient(90deg,transparent,#5ab9b4,transparent)}
.cc-art-tag{position:absolute;padding:.55rem .7rem;border:1px solid rgba(90,185,180,.28);background:rgba(7,20,31,.82);color:#c0e2fd;font:500 .56rem var(--font-mono,monospace);letter-spacing:.12em;backdrop-filter:blur(8px)}.cc-tag-one{left:7%;top:23%}.cc-tag-two{right:6%;top:30%}.cc-tag-three{left:35%;bottom:13%}
.cc-hero-art>small{position:absolute;left:1.3rem;bottom:1.2rem;color:#819eab;font:500 .53rem var(--font-mono,monospace);letter-spacing:.13em}
.cc-hero-foot{display:flex;align-items:center;gap:1rem;padding-top:2rem;color:#7695a4;font:500 .58rem var(--font-mono,monospace);letter-spacing:.14em}.cc-hero-foot i{height:1px;flex:1;max-width:5rem;background:linear-gradient(90deg,#0382bd,#5ab9b4)}
.cc-section{padding:clamp(5rem,9vw,8rem) 0;border-top:1px solid var(--cc-line)}
.cc-section-head{display:grid;grid-template-columns:1fr .7fr;column-gap:5vw;align-items:end}.cc-section-head .cc-kicker{grid-column:1/-1}.cc-section-head h2{font-size:clamp(2.7rem,4.9vw,4.8rem)}.cc-section-head>p:last-child{max-width:28rem;margin:0 0 .3rem;color:var(--cc-muted);line-height:1.85}
.cc-career-panel{position:relative;display:grid;grid-template-columns:minmax(10rem,.45fr) 1fr auto;align-items:center;gap:clamp(1.5rem,4vw,4rem);margin-top:3.5rem;padding:clamp(1.5rem,4vw,3.5rem);border:1px solid var(--cc-line);background:radial-gradient(ellipse at 18% 50%,rgba(3,130,189,.16),transparent 42%),linear-gradient(130deg,#0c202e,#091722)}
.cc-career-symbol{position:relative;display:grid;place-items:center;min-height:12rem;border:1px solid rgba(90,185,180,.23);background:radial-gradient(circle,rgba(3,130,189,.18),transparent 62%)}
.cc-career-symbol span{color:#d9f5f1;font-size:5rem;font-weight:800;letter-spacing:-.1em}.cc-career-symbol i{position:absolute;inset:18%;border:1px solid rgba(90,185,180,.3);border-radius:50%;transform:rotate(-30deg) scaleY(.55)}
.cc-career-copy small,.cc-card-index{color:#80c9c8;font:500 .57rem var(--font-mono,monospace);letter-spacing:.14em}
.cc-career-copy h3{margin:1rem 0;color:white;font-size:clamp(1.8rem,3vw,3rem);line-height:1.08;letter-spacing:-.05em}
.cc-career-copy p{max-width:44rem;color:var(--cc-muted);font-size:.9rem;line-height:1.8}.cc-career-copy>a{display:inline-flex;gap:1rem;margin-top:1.2rem;color:#c0e2fd;text-decoration:none;font-size:.8rem;font-weight:650}.cc-career-copy>a span{color:var(--cc-teal)}
.cc-career-status{display:flex;align-items:center;gap:.55rem;align-self:start;color:#91aab5;font:500 .52rem var(--font-mono,monospace);letter-spacing:.1em;white-space:nowrap}.cc-career-status i{width:.38rem;height:.38rem;border-radius:50%;background:#5ab9b4;box-shadow:0 0 10px #5ab9b4}
.cc-contact{background:linear-gradient(180deg,#081622,#0a1a27)}
.cc-contact-grid{display:grid;grid-template-columns:1fr .9fr;gap:clamp(2rem,7vw,7rem);align-items:center}.cc-contact-intro h2{font-size:clamp(2.8rem,5vw,5rem)}.cc-contact-intro>p:last-child{max-width:34rem;margin-top:1.5rem;color:var(--cc-muted);line-height:1.9}
.cc-contact-card{position:relative;min-height:25rem;padding:2rem;border:1px solid rgba(90,185,180,.3);background:radial-gradient(ellipse at 75% 20%,rgba(3,130,189,.2),transparent 48%),#0b1d2a}
.cc-card-orb{width:4.5rem;height:4.5rem;margin:2rem 0 1.4rem;border:1px solid rgba(90,185,180,.5);border-radius:42% 58% 50% 50%;background:radial-gradient(circle at 35% 35%,#5ab9b455,transparent 70%);box-shadow:0 0 35px #0382bd20;animation:cc-orb-morph 10s ease-in-out infinite alternate}.cc-card-orb i{display:block;width:100%;height:100%;border:1px solid rgba(192,226,253,.25);border-radius:50%;transform:scale(.65) rotate(45deg)}
.cc-contact-card h3{margin:0;color:white;font-size:clamp(1.8rem,3vw,2.6rem);line-height:1.1;letter-spacing:-.05em}.cc-contact-card>p{margin:1rem 0;color:var(--cc-muted);font-size:.82rem;line-height:1.8}.cc-contact-card>a{display:inline-flex;gap:1.2rem;margin-top:.7rem;color:#c0e2fd;text-decoration:none;font-size:.8rem;font-weight:650}.cc-contact-card>a span{color:var(--cc-teal)}
.cc-next{padding:clamp(4rem,7vw,6rem) 0;border-top:1px solid var(--cc-line);background:radial-gradient(ellipse at 10% 70%,rgba(3,130,189,.12),transparent 40%),#07121d}
.cc-next-inner{display:grid;grid-template-columns:1fr .8fr;gap:3rem;align-items:center}.cc-next h2{font-size:clamp(2.5rem,4.5vw,4.4rem)}
.cc-next-links{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.cc-next-links a{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid var(--cc-line);color:#d8e8ee;text-decoration:none;font-size:.8rem;transition:border-color .3s,background .3s}.cc-next-links a:hover{border-color:#5ab9b4;background:rgba(90,185,180,.06)}.cc-next-links a span{color:#75cbc8}
@keyframes cc-morph{0%{border-radius:45% 55% 52% 48%/48% 42% 58% 52%;transform:translate(-50%,-50%) rotate(-5deg)}100%{border-radius:57% 43% 42% 58%/39% 59% 41% 61%;transform:translate(-50%,-50%) rotate(5deg)}}
@keyframes cc-orb-morph{0%{border-radius:42% 58% 50% 50%;transform:rotate(-5deg)}100%{border-radius:57% 43% 42% 58%;transform:rotate(5deg)}}
@media(max-width:850px){.cc-hero-grid,.cc-contact-grid,.cc-next-inner{grid-template-columns:1fr}.cc-hero-grid{min-height:0}.cc-hero-art{min-height:27rem}.cc-section-head{grid-template-columns:1fr;gap:1rem}.cc-career-panel{grid-template-columns:10rem 1fr}.cc-career-status{grid-column:2}.cc-next-links{max-width:35rem}}
@media(max-width:560px){.cc-wrap{width:calc(100% - 2rem)}.cc-hero{padding-top:3.5rem}.cc-hero h1{font-size:clamp(2.8rem,13vw,4.2rem)}.cc-hero-art{min-height:22rem}.cc-art-ring{width:14rem;height:14rem}.cc-ring-two{width:18rem;height:18rem}.cc-ring-three{width:22rem;height:22rem}.cc-art-core{width:9.5rem;height:9.5rem}.cc-art-core b{font-size:.95rem}.cc-art-tag{font-size:.46rem;padding:.45rem .5rem}.cc-tag-one{left:3%;top:19%}.cc-tag-two{right:3%;top:24%}.cc-tag-three{left:28%;bottom:11%}.cc-hero-foot{gap:.5rem;font-size:.46rem}.cc-career-panel{grid-template-columns:1fr;gap:1.5rem;padding:1.2rem}.cc-career-symbol{min-height:10rem}.cc-career-status{grid-column:auto}.cc-contact-card{padding:1.4rem;min-height:0}.cc-next-links{grid-template-columns:1fr}.cc-section{padding:4.5rem 0}}
@media(prefers-reduced-motion:reduce){.cc-page *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>