---
const teamPrinciples = [
  ['Curiosity', 'We question assumptions, get close to the details, and stay open to changing our minds when the evidence tells us to.'],
  ['Ownership', 'We care about the problem beyond the brief and take responsibility for making the work better.'],
  ['Execution', 'We move between ideas and action—testing, learning, and improving in the real world.'],
];
---

<main class="team-experience">
  <section class="team-hero"><div class="team-wrap">
    <p class="team-eyebrow">THE PEOPLE BEHIND E DEVİSER</p>
    <div class="team-hero-grid"><h1>People who care<br />about the problems<br /><em>they take on.</em></h1><div class="team-hero-aside"><p>Our leadership brings together the experience, perspective, and determination needed to turn difficult ideas into real work.</p><a class="team-link" href="#leadership">Explore our approach <span aria-hidden="true">↓</span></a></div></div>
    <div class="team-hero-foot"><span>WHAT WE VALUE</span><p>Perspective <i></i> Responsibility <i></i> Follow-through</p></div>
  </div></section>

  <section class="team-section" id="leadership"><div class="team-wrap team-leadership">
    <div class="team-section-label"><p class="team-eyebrow">SENIOR LEADERSHIP</p><span>Leadership is<br />responsibility<br />in practice.</span></div>
    <div class="team-leadership-copy"><h2>People behind<br /><em>the decisions.</em></h2><p>Leadership at E Deviser is about taking responsibility for difficult problems and carrying ideas through to meaningful work.</p><div class="team-profile-status"><span>LEADERSHIP PROFILES</span><p>Names, titles, and biographies will be published once confirmed. We won't manufacture profiles or imply a team structure that hasn't been approved.</p></div></div>
  </div></section>

  <section class="team-section team-section-alt"><div class="team-wrap">
    <div class="team-section-heading"><div><p class="team-eyebrow">THE TEAM</p><h2>Curiosity. Ownership.<br /><em>Execution.</em></h2></div><p>Different perspectives and disciplines, connected by one shared expectation: if something matters, do the work to make it better.</p></div>
    <div class="team-principles">{teamPrinciples.map((principle) => <article class="team-principle"><h3>{principle[0]}</h3><p>{principle[1]}</p></article>)}</div>
  </div></section>

  <section class="team-section"><div class="team-wrap team-standard"><div><p class="team-eyebrow">OUR SHARED STANDARD</p><h2>Different strengths.<br /><em>One commitment.</em></h2></div><div><p>We challenge assumptions, get close to the details, and stay open to changing our minds when the evidence tells us to.</p><p>We value people who can move between ideas and execution—people who don't just ask what is possible, but what is worth doing.</p><a class="team-link" href="/company/">More about E Deviser <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="team-closing"><div class="team-wrap"><p class="team-eyebrow">BUILD WITH US</p><h2>Bring your perspective.<br /><em>Make something matter.</em></h2><a class="team-button" href="/company/careers-contact/">Careers &amp; contact <span aria-hidden="true">↗</span></a></div></section>
</main>

<style>
.team-experience{background:var(--color-surface-raised);color:var(--color-text);overflow:hidden}.team-experience *{box-sizing:border-box}.team-wrap{width:min(var(--container-wide),calc(100% - 2*var(--gutter)));margin-inline:auto}.team-eyebrow{margin:0 0 1.25rem;color:var(--primary-700);font:600 .68rem/1.5 var(--font-body);letter-spacing:.12em}
.team-hero{padding:clamp(5rem,10vw,9rem) 0 2.2rem}.team-hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,8vw,8rem);align-items:end}.team-experience h1,.team-experience h2{margin:0;color:var(--color-text);font-family:var(--font-display);font-weight:700;letter-spacing:-.06em;line-height:1.03;text-wrap:balance}.team-experience h1{font-size:clamp(3.3rem,7vw,7rem)}.team-experience h2{font-size:clamp(2.5rem,4.8vw,4.7rem)}.team-experience em{color:var(--brand-blue);font-style:normal}.team-hero-aside{max-width:28rem;padding-bottom:.5rem}.team-hero-aside>p,.team-standard>div:last-child p{color:var(--color-text-muted);font-size:var(--text-body-large);line-height:1.8}.team-link{display:inline-flex;gap:.8rem;margin-top:1.2rem;color:var(--primary-700);font-size:var(--text-sm);font-weight:600;text-decoration:none}.team-link span{color:var(--brand-teal)}.team-hero-foot{display:flex;justify-content:space-between;gap:2rem;margin-top:clamp(4rem,8vw,7rem);padding:1.15rem 0;border-block:1px solid var(--color-border)}.team-hero-foot span,.team-hero-foot p{margin:0;color:var(--color-text-subtle);font:500 .62rem var(--font-mono);letter-spacing:.1em}.team-hero-foot p{display:flex;gap:1rem;color:var(--primary-800)}.team-hero-foot i{width:1.8rem;height:1px;align-self:center;background:var(--brand-teal)}
.team-section{padding:clamp(4.5rem,8vw,7.5rem) 0;border-top:1px solid var(--color-border-subtle)}.team-section-alt{background:var(--color-surface-subtle)}.team-leadership{display:grid;grid-template-columns:.55fr 1.45fr;gap:clamp(2rem,8vw,9rem)}.team-section-label>span{display:block;margin-top:3rem;color:var(--color-text-subtle);font:500 .8rem/1.7 var(--font-mono)}.team-leadership-copy{max-width:55rem}.team-leadership-copy>p{max-width:40rem;margin:1.5rem 0;color:var(--color-text-muted);font-size:var(--text-body-large);line-height:1.8}.team-profile-status{display:grid;grid-template-columns:12rem 1fr;gap:2rem;margin-top:3rem;padding:1.3rem 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.team-profile-status span{color:var(--primary-700);font:500 .6rem var(--font-mono);letter-spacing:.1em}.team-profile-status p{max-width:38rem;margin:0;color:var(--color-text-subtle);font-size:.88rem;line-height:1.75}
.team-section-heading{display:grid;grid-template-columns:1fr .7fr;gap:3rem;align-items:end}.team-section-heading>p{max-width:30rem;margin:0;color:var(--color-text-muted);line-height:1.8}.team-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3.5rem}.team-principle{padding:1.5rem 0 0;border-top:2px solid var(--brand-teal)}.team-principle h3{margin:0 0 1rem;color:var(--color-text);font:600 clamp(1.4rem,2.2vw,1.8rem) var(--font-display);letter-spacing:-.035em}.team-principle p{max-width:24rem;margin:0;color:var(--color-text-muted);font-size:.92rem;line-height:1.8}
.team-standard{display:grid;grid-template-columns:1fr .8fr;gap:clamp(2rem,8vw,8rem);align-items:start}.team-standard>div:last-child p{margin:0 0 1rem;font-size:1rem}.team-closing{padding:clamp(4.5rem,8vw,7.5rem) 0;border-top:1px solid var(--color-border);background:var(--color-surface-subtle)}.team-closing h2{font-size:clamp(3rem,6vw,5.8rem)}.team-button{display:inline-flex;gap:1rem;margin-top:2rem;padding:.85rem 1.15rem;border:1px solid var(--primary-700);color:var(--primary-800);font-size:var(--text-sm);font-weight:600;text-decoration:none;transition:background var(--transition-interactive),color var(--transition-interactive)}.team-button:hover{background:var(--primary-700);color:#fff}.team-button span{color:var(--brand-teal)}
@media(max-width:800px){.team-hero-grid,.team-leadership,.team-section-heading,.team-standard{grid-template-columns:1fr;gap:2rem}.team-section-label>span{margin-top:0}.team-principles{gap:1.2rem}}
@media(max-width:560px){.team-wrap{width:calc(100% - 2rem)}.team-hero{padding-top:4rem}.team-experience h1{font-size:clamp(2.8rem,13vw,4.5rem)}.team-experience h2{font-size:clamp(2.3rem,10vw,3.5rem)}.team-hero-foot{flex-direction:column;gap:.8rem;margin-top:3rem}.team-hero-foot p{gap:.6rem;font-size:.52rem}.team-profile-status{grid-template-columns:1fr;gap:.8rem}.team-principles{grid-template-columns:1fr;gap:2rem}.team-section{padding:4.25rem 0}}
@media(prefers-reduced-motion:reduce){.team-experience *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
