---
import '../../styles/components/company.css';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<div class="company-team">
  <SectionWrapper background="light" class="company-team-hero">
    <section aria-labelledby="company-team-title">
      <Container width="wide" class="company-team-hero-grid">
        <div>
          <p class="eyebrow">THE PEOPLE BEHIND THE WORK</p>
          <h1 id="company-team-title">The people behind <em>the work.</em></h1>
          <p class="company-lead">A team built around curiosity, ownership, and execution.</p>
        </div>
        <div class="company-team-visual" aria-hidden="true">
          <div class="company-team-signal">
            <span>01 / CURIOSITY</span>
            <strong>Ask<br/>better<br/><em>questions.</em></strong>
            <i></i>
          </div>
          <span class="company-team-caption">PEOPLE → PERSPECTIVE → PROGRESS</span>
        </div>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="light" class="company-section company-section--soft">
    <section aria-labelledby="company-team-principles-title">
      <Container width="wide" class="company-split">
        <SectionHeading
          eyebrow="OUR CULTURE"
          title="Curious enough to question. Practical enough to build."
          id="company-team-principles-title"
        />
        <div class="company-copy">
          <p>We challenge assumptions, get close to the details, and stay open to changing our minds when the evidence tells us to.</p>
          <p>We value people who can move between ideas and execution—people who don't just ask what is possible, but what is worth doing.</p>
        </div>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="light" class="company-section company-team-close">
    <section aria-labelledby="company-team-close-title">
      <Container width="wide" class="company-close-content">
        <p class="eyebrow">BUILD WITH US</p>
        <h2 id="company-team-close-title">Bring your perspective.<br/><em>Make something matter.</em></h2>
        <Button href="/company/careers-contact/" label="Careers & contact" variant="outline" />
      </Container>
    </section>
  </SectionWrapper>
</div>
