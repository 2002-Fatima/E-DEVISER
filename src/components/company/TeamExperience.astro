---
const teamPrinciples = [
  ['Curiosity', 'We question assumptions, get close to the details, and stay open to changing our minds when the evidence tells us to.'],
  ['Ownership', 'We care about the problem beyond the brief and take responsibility for making the work better.'],
  ['Execution', 'We move between ideas and action—testing, learning, and improving in the real world.'],
];
---

<main class="team-experience">
  <section class="team-hero">
    <div class="team-wrap team-hero-grid">
      <div>
        <p class="team-eyebrow">THE PEOPLE LEADING E DEVİSER</p>
        <h1>Built by people who care deeply about <em>the problems they take on.</em></h1>
        <p class="team-lead">Our leadership brings together the experience, perspective, and determination needed to turn difficult ideas into real work.</p>
        <a class="team-link" href="#leadership">Our leadership <span aria-hidden="true">↓</span></a>
      </div>
      <div class="team-hero-art" aria-hidden="true">
        <div class="team-art-grid"></div><div class="team-orbit team-orbit-a"></div><div class="team-orbit team-orbit-b"></div><div class="team-orbit team-orbit-c"></div>
        <div class="team-core"><span>E.</span><small>PEOPLE / PURPOSE / PROGRESS</small></div>
        <b class="team-art-label team-art-label-a">PERSPECTIVE</b><b class="team-art-label team-art-label-b">EXPERIENCE</b><b class="team-art-label team-art-label-c">DETERMINATION</b>
      </div>
    </div>
  </section>

  <section class="team-section" id="leadership">
    <div class="team-wrap">
      <div class="team-section-heading">
        <div><p class="team-eyebrow">SENIOR LEADERSHIP</p><h2>People behind<br /><em>the decisions.</em></h2></div>
        <p>Leadership at E Deviser is about taking responsibility for difficult problems and carrying ideas through to meaningful work.</p>
      </div>
      <div class="team-leadership-note">
        <span class="team-note-mark" aria-hidden="true">E.</span>
        <div><small>LEADERSHIP PROFILES</small><h3>Confirmed people. Real experience. Clear responsibility.</h3><p>The supplied company content does not include approved executive names, titles, or biographies. We will publish leadership profiles when those details are confirmed—never invented to fill a layout.</p></div>
        <span class="team-note-status">PROFILES PENDING APPROVAL</span>
      </div>
    </div>
  </section>

  <section class="team-section team-section-alt">
    <div class="team-wrap">
      <div class="team-section-heading">
        <div><p class="team-eyebrow">THE PEOPLE BEHIND THE WORK</p><h2>A team built around curiosity, <em>ownership, and execution.</em></h2></div>
        <p>Different perspectives. Different disciplines. One shared expectation: if something matters, we should be willing to do the work to make it better.</p>
      </div>
      <div class="team-principles">
        {teamPrinciples.map((principle, index) => (
          <article class="team-principle">
            <span>0{index + 1}</span>
            <div class="team-principle-mark" aria-hidden="true"><i></i><i></i><i></i></div>
            <h3>{principle[0]}</h3>
            <p>{principle[1]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="team-section">
    <div class="team-wrap team-standard">
      <div><p class="team-eyebrow">OUR SHARED STANDARD</p><h2>Different strengths.<br /><em>One commitment to the work.</em></h2></div>
      <div><p>We challenge assumptions, get close to the details, and stay open to changing our minds when the evidence tells us to.</p><p>We value people who can move between ideas and execution—people who don't just ask what is possible, but what is worth doing.</p><a class="team-link" href="/company/">More about E Deviser <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="team-closing">
    <div class="team-wrap">
      <p class="team-eyebrow">BUILD WITH US</p>
      <h2>Bring your perspective.<br /><em>Make something matter.</em></h2>
      <p>We are building a company for people who care deeply about the problems they take on.</p>
      <a class="team-button" href="/company/careers-contact/">Careers &amp; contact <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</main>

<style>
.team-experience{background:var(--color-surface-night);color:var(--color-text-inverse);overflow:hidden}
.team-experience *{box-sizing:border-box}
.team-wrap{width:min(var(--container-wide),calc(100% - 2*var(--gutter)));margin-inline:auto}
.team-hero{padding:clamp(4rem,7vw,7rem) 0;background:var(--gradient-hero-approved)}
.team-hero-grid,.team-section-heading,.team-standard{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:clamp(2rem,7vw,7rem);align-items:center}
.team-eyebrow{margin:0 0 1.4rem;color:var(--brand-teal-light);font:var(--weight-semibold) var(--text-xs)/1.5 var(--font-body);letter-spacing:var(--tracking-wide)}
.team-experience h1,.team-experience h2{margin:0;color:var(--color-text-inverse);font-family:var(--font-display);font-weight:var(--weight-bold);letter-spacing:-.055em;line-height:1.04;text-wrap:balance}
.team-experience h1{font-size:clamp(2.9rem,5.8vw,5.6rem)}
.team-experience h2{font-size:clamp(2.35rem,4.3vw,4.4rem)}
.team-experience h1 em,.team-experience h2 em{color:var(--brand-teal-light);font-style:normal}
.team-lead{max-width:40rem;margin:1.5rem 0 0;color:var(--color-text-inverse-muted);font-size:var(--text-body-large);line-height:1.8}
.team-link{display:inline-flex;align-items:center;gap:1rem;margin-top:1.5rem;color:var(--brand-blue-light);font-size:var(--text-sm);font-weight:var(--weight-semibold);text-decoration:none}
.team-link span{color:var(--brand-teal-light)}
.team-hero-art{position:relative;min-height:clamp(22rem,36vw,30rem);overflow:hidden;border:1px solid var(--color-border-inverse);background:var(--gradient-dark-luminous)}
.team-art-grid{position:absolute;inset:0;background:var(--pattern-grid);background-size:2.5rem 2.5rem;opacity:.28;mask-image:radial-gradient(ellipse at center,#000 15%,transparent 78%)}
.team-orbit{position:absolute;left:50%;top:48%;width:68%;aspect-ratio:1;border:1px solid color-mix(in srgb,var(--brand-teal) 34%,transparent);border-radius:50%;transform:translate(-50%,-50%) scaleY(.48) rotate(-28deg)}
.team-orbit-b{width:82%;border-color:color-mix(in srgb,var(--brand-blue-light) 28%,transparent);transform:translate(-50%,-50%) scaleY(.48) rotate(52deg)}
.team-orbit-c{width:56%;border-color:color-mix(in srgb,var(--brand-teal-light) 22%,transparent);transform:translate(-50%,-50%) scaleY(.48) rotate(80deg)}
.team-core{position:absolute;left:50%;top:48%;width:8rem;aspect-ratio:1;display:grid;place-content:center;justify-items:center;border:1px solid var(--color-border-inverse-strong);border-radius:50%;background:var(--color-surface-night-raised);box-shadow:0 0 4rem color-mix(in srgb,var(--brand-blue) 20%,transparent);transform:translate(-50%,-50%)}
.team-core>span{font:var(--weight-bold) 3.4rem/1 var(--font-display);letter-spacing:-.1em}
.team-core>small{margin-top:.7rem;color:var(--color-text-inverse-subtle);font:500 .48rem var(--font-mono);letter-spacing:.1em;white-space:nowrap}
.team-art-label{position:absolute;padding:.5rem .65rem;border:1px solid var(--color-border-inverse);background:var(--color-surface-night-raised);color:var(--brand-blue-light);font:500 .53rem var(--font-mono);letter-spacing:.1em}
.team-art-label-a{left:6%;top:22%}.team-art-label-b{right:6%;top:28%}.team-art-label-c{left:28%;bottom:17%}
.team-section{padding:clamp(4.5rem,8vw,7.5rem) 0;border-top:1px solid var(--color-border-inverse)}
.team-section-alt{background:var(--color-surface-night-raised)}
.team-section-heading{align-items:end}
.team-section-heading>p{max-width:35rem;margin:0;color:var(--color-text-inverse-muted);line-height:1.85}
.team-leadership-note{display:grid;grid-template-columns:4rem minmax(0,1fr) auto;gap:1.5rem;align-items:center;margin-top:3rem;padding:clamp(1.3rem,3vw,2.2rem);border:1px solid var(--color-border-inverse);background:linear-gradient(110deg,color-mix(in srgb,var(--brand-blue) 12%,var(--color-surface-night-raised)),var(--color-surface-night-raised))}
.team-note-mark{display:grid;place-items:center;width:3.5rem;aspect-ratio:1;border:1px solid var(--color-border-inverse-strong);border-radius:50%;color:var(--brand-teal-light);font:var(--weight-bold) 1.3rem var(--font-display)}
.team-leadership-note small,.team-note-status{color:var(--brand-teal-light);font:500 .55rem var(--font-mono);letter-spacing:.12em}
.team-leadership-note h3{margin:.7rem 0;color:var(--color-text-inverse);font-size:1.25rem}
.team-leadership-note p{max-width:65ch;margin:0;color:var(--color-text-inverse-muted);font-size:.88rem;line-height:1.75}
.team-note-status{white-space:nowrap;color:var(--color-text-inverse-subtle)}
.team-principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:3rem}
.team-principle{min-height:18rem;padding:1.5rem;border:1px solid var(--color-border-inverse);background:linear-gradient(145deg,var(--color-surface-night-hover),var(--color-surface-night-raised))}
.team-principle>span{color:var(--brand-teal-light);font:500 .58rem var(--font-mono);letter-spacing:.1em}
.team-principle-mark{display:flex;align-items:center;gap:.4rem;height:3.5rem;margin:1.2rem 0}
.team-principle-mark i{width:.55rem;border:1px solid var(--brand-teal);border-radius:var(--radius-pill);background:linear-gradient(180deg,color-mix(in srgb,var(--brand-teal) 65%,transparent),transparent)}
.team-principle-mark i:nth-child(1){height:1.1rem}.team-principle-mark i:nth-child(2){height:2.5rem}.team-principle-mark i:nth-child(3){height:1.7rem}
.team-principle h3{margin:0 0 .7rem;color:var(--color-text-inverse);font-size:1.35rem}
.team-principle p{margin:0;color:var(--color-text-inverse-muted);font-size:.88rem;line-height:1.8}
.team-standard>div:last-child p{color:var(--color-text-inverse-muted);line-height:1.85}
.team-closing{padding:clamp(4.5rem,8vw,7rem) 0;border-top:1px solid var(--color-border-inverse);background:var(--gradient-hero-approved)}
.team-closing h2{font-size:clamp(2.7rem,5.4vw,5.2rem)}
.team-closing>div>p:not(.team-eyebrow){max-width:40rem;color:var(--color-text-inverse-muted);line-height:1.8}
.team-button{display:inline-flex;align-items:center;gap:1rem;margin-top:1rem;padding:.85rem 1.2rem;border:1px solid var(--brand-teal);border-radius:var(--radius-pill);color:var(--color-text-inverse);font-size:var(--text-sm);font-weight:var(--weight-semibold);text-decoration:none}
.team-button span{color:var(--brand-teal-light)}
@media(max-width:800px){.team-hero-grid,.team-section-heading,.team-standard{grid-template-columns:1fr;gap:2rem}.team-hero-art{min-height:23rem}.team-leadership-note{grid-template-columns:3.5rem 1fr}.team-note-status{grid-column:2}.team-principles{grid-template-columns:1fr 1fr}.team-principle:last-child{grid-column:1/-1}}
@media(max-width:560px){.team-wrap{width:calc(100% - 2rem)}.team-experience h1{font-size:clamp(2.55rem,11vw,3.7rem)}.team-experience h2{font-size:clamp(2.25rem,9.5vw,3.3rem)}.team-hero-art{min-height:19rem}.team-core{width:6.5rem}.team-core>span{font-size:2.8rem}.team-art-label{font-size:.44rem;padding:.4rem .45rem}.team-principles{grid-template-columns:1fr}.team-principle:last-child{grid-column:auto}.team-leadership-note{grid-template-columns:1fr}.team-note-status{grid-column:auto}.team-section{padding:4.5rem 0}}
@media(prefers-reduced-motion:reduce){.team-experience *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>