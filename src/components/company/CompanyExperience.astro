---
import '../../styles/components/company.css';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Link from '../ui/Link.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SectionNavigation from '../layout/SectionNavigation.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import { companyBeliefs } from '../../content/company';

const navItems = [
  { label: 'Why', href: '#why' },
  { label: 'Beliefs', href: '#beliefs' },
  { label: 'Where we are', href: '#today' },
  { label: 'Culture', href: '#culture' },
];
---

<div class="company-experience">
  <SectionWrapper background="dark" class="company-hero">
    <section aria-labelledby="company-title">
      <Container width="wide" class="company-hero-grid">
        <div class="company-hero-copy">
          <p class="eyebrow">THE COMPANY</p>
          <h1 id="company-title">Built to solve<br/><em>what matters.</em></h1>
          <p>E Deviser is a problem-solving company built around a simple belief: important problems deserve the curiosity, depth, and determination to find better ways forward.</p>
        </div>
        <figure class="company-hero-media">
          <img
            src="/media/investor-group-nicat.webp"
            alt="A group gathered at an industry event"
            width="960"
            height="960"
            loading="lazy"
            decoding="async"
          />
          <figcaption>A COMPANY BUILT AROUND THE WORK.</figcaption>
        </figure>
      </Container>
    </section>
  </SectionWrapper>

  <SectionNavigation items={navItems} class="company-section-nav" />

  <SectionWrapper background="light" id="why" class="company-section company-why">
    <section aria-labelledby="company-why-title">
      <Container width="wide">
        <div class="company-split">
          <SectionHeading
            eyebrow="WHY E DEVISER EXISTS"
            title="Because some problems are worth going deeper for."
            id="company-why-title"
          />
          <div class="company-copy">
            <p>We started E Deviser to build—not simply advise, observe, or wait for someone else to solve the difficult problems we care about.</p>
            <p>We believe meaningful progress comes from getting close to the problem, understanding what makes it difficult, bringing the right people and capabilities together, and having the courage to build something new.</p>
          </div>
        </div>
        <Card as="div" variant="light" class="company-statement">
          <small>OUR REASON TO BUILD</small>
          <strong>Get close to the problem.<br/>Bring the right capabilities.<br/><em>Make progress real.</em></strong>
        </Card>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="light" id="beliefs" class="company-section company-section--soft">
    <section aria-labelledby="company-beliefs-title">
      <Container width="wide">
        <SectionHeading
          eyebrow="OUR BELIEFS"
          title="Principles that shape the work."
          description="These are not slogans for the wall. They are the questions we return to when deciding what deserves our time, attention, and effort."
          id="company-beliefs-title"
        />
        <ol class="company-beliefs">
          {companyBeliefs.map((belief) => (
            <li>
              <Badge tone="neutral" label={belief.number} />
              <div>
                <h3>{belief.title}</h3>
                <p>{belief.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="dark" id="today" class="company-section company-section--dark">
    <section aria-labelledby="company-today-title">
      <Container width="wide" class="company-split company-split--dark">
        <div class="company-now-copy">
          <p class="eyebrow">WHERE WE ARE NOW</p>
          <h2 id="company-today-title">Going deep on <em>learning.</em></h2>
          <p>Education is where we are currently applying our approach most deeply—because learning is consequential, complex, measurable, and capable of affecting millions of lives.</p>
          <p>Cuevo is the first major expression of that commitment.</p>
          <Link href="/cuevo/">Explore Cuevo ↗</Link>
        </div>
        <Card as="div" variant="dark" class="company-cuevo-card">
          <Badge tone="neutral" label="OUR FIRST MAJOR EXPRESSION" />
          <strong>CUEVO</strong>
          <span>INTELLIGENCE FOR LEARNING</span>
        </Card>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="light" id="culture" class="company-section">
    <section aria-labelledby="company-culture-title">
      <Container width="wide" class="company-split">
        <SectionHeading
          eyebrow="OUR CULTURE"
          title="Small enough to stay curious. Ambitious enough to matter."
          id="company-culture-title"
        />
        <div class="company-copy">
          <p>E Deviser is still early. That's intentional.</p>
          <p>We are building a company capable of going deep on difficult problems, developing new capabilities along the way, and carrying what we learn from one challenge into the next.</p>
          <p>The company may evolve. The problems we work on may change. The technologies will certainly change.</p>
          <strong>Our willingness to build will not.</strong>
        </div>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="dark" class="company-section company-close">
    <section aria-labelledby="company-close-title">
      <Container width="wide" class="company-close-content">
        <p class="eyebrow">STILL BUILDING</p>
        <h2 id="company-close-title">The problems will change.<br/><em>The ambition won't.</em></h2>
        <p>We are building E Deviser for the long term—one important problem, one real solution, and one lesson at a time.</p>
        <Button href="/company/careers-contact/" label="Talk to E Deviser" variant="inverse" />
      </Container>
    </section>
  </SectionWrapper>
</div>
