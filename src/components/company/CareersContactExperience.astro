---
const paths = [
  ['A problem worth solving', 'Bring us a difficult problem that deserves curiosity, depth, and determination.'],
  ['A collaboration to explore', 'Work with us to bring the right people and capabilities together.'],
  ['A willingness to build', 'If you move between ideas and execution, we want to hear what you could contribute.'],
];
---

<main class="contact-experience">
  <section class="contact-hero">
    <div class="contact-wrap contact-hero-grid">
      <div>
        <p class="contact-eyebrow">CAREERS &amp; CONTACT</p>
        <h1>Good work starts<br />with a <em>conversation.</em></h1>
        <p class="contact-lead">We are building E Deviser around important problems, thoughtful people, and the determination to turn ideas into meaningful work. If that is the kind of work you care about, start here.</p>
        <a class="contact-link" href="#contact">Start a conversation <span aria-hidden="true">↓</span></a>
      </div>
      <div class="contact-hero-art" aria-hidden="true">
        <div class="contact-art-grid"></div><div class="contact-ring contact-ring-one"></div><div class="contact-ring contact-ring-two"></div><div class="contact-ring contact-ring-three"></div>
        <div class="contact-art-core"><small>START WITH</small><strong>A QUESTION</strong><i></i></div>
        <span class="contact-art-label contact-label-one">IDEAS</span><span class="contact-art-label contact-label-two">PEOPLE</span><span class="contact-art-label contact-label-three">POSSIBILITY</span>
        <small class="contact-art-caption">OPEN TO WHAT MATTERS</small>
      </div>
    </div>
  </section>

  <section class="contact-section" id="careers">
    <div class="contact-wrap">
      <div class="contact-section-heading">
        <div><p class="contact-eyebrow">CAREERS AT E DEVİSER</p><h2>Curious enough to question.<br /><em>Practical enough to build.</em></h2></div>
        <p>We value people who challenge assumptions, get close to the details, and stay open to changing their minds when the evidence tells them to. We look for people who ask not only what is possible, but what is worth doing.</p>
      </div>
      <div class="contact-paths">
        {paths.map((path, index) => (
          <article><span>0{index + 1}</span><div><h3>{path[0]}</h3><p>{path[1]}</p></div><b aria-hidden="true">↗</b></article>
        ))}
      </div>
      <div class="contact-opportunities">
        <span>OPPORTUNITIES</span>
        <div><strong>We publish roles when they are real.</strong><p>There are no confirmed vacancies in the supplied company content. We will add opportunities here when roles and application details are approved.</p></div>
        <a href="/company/team/">Meet the team <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="contact-section contact-section-alt" id="contact">
    <div class="contact-wrap contact-conversation">
      <div>
        <p class="contact-eyebrow">GET IN TOUCH</p>
        <h2>Have something<br /><em>worth exploring?</em></h2>
        <p>Whether you have a problem to solve, an idea to discuss, or want to learn more about E Deviser, the starting point is a thoughtful conversation.</p>
      </div>
      <div class="contact-channel">
        <span>START A CONVERSATION</span>
        <strong>Talk to E Deviser.</strong>
        <p>A public email address, phone number, or working enquiry destination was not included in the supplied content. We have not invented one or added a form that cannot deliver messages.</p>
        <small>CONTACT CHANNEL TO BE CONFIRMED</small>
      </div>
    </div>
  </section>

  <section class="contact-next">
    <div class="contact-wrap contact-next-grid">
      <div><p class="contact-eyebrow">GET TO KNOW US</p><h2>See what we're<br /><em>building.</em></h2></div>
      <div class="contact-next-links"><a href="/company/">Company overview <span aria-hidden="true">↗</span></a><a href="/company/team/">Meet the team <span aria-hidden="true">↗</span></a><a href="/what-we-build/">What We Build <span aria-hidden="true">↗</span></a><a href="/our-work/">Our Work <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</main>

<style>
.contact-experience{background:var(--color-surface-night);color:var(--color-text-inverse);overflow:hidden}
.contact-experience *{box-sizing:border-box}
.contact-wrap{width:min(var(--container-wide),calc(100% - 2*var(--gutter)));margin-inline:auto}
.contact-hero{padding:clamp(4rem,7vw,7rem) 0;background:var(--gradient-hero-approved)}
.contact-hero-grid,.contact-section-heading,.contact-conversation,.contact-next-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:clamp(2rem,7vw,7rem);align-items:center}
.contact-eyebrow{margin:0 0 1.4rem;color:var(--brand-teal-light);font:var(--weight-semibold) var(--text-xs)/1.5 var(--font-body);letter-spacing:var(--tracking-wide)}
.contact-experience h1,.contact-experience h2{margin:0;color:var(--color-text-inverse);font-family:var(--font-display);font-weight:var(--weight-bold);letter-spacing:-.055em;line-height:1.04;text-wrap:balance}
.contact-experience h1{font-size:clamp(3rem,5.8vw,5.8rem)}
.contact-experience h2{font-size:clamp(2.35rem,4.4vw,4.5rem)}
.contact-experience h1 em,.contact-experience h2 em{color:var(--brand-teal-light);font-style:normal}
.contact-lead{max-width:40rem;margin:1.5rem 0 0;color:var(--color-text-inverse-muted);font-size:var(--text-body-large);line-height:1.8}
.contact-link{display:inline-flex;gap:1rem;margin-top:1.5rem;color:var(--brand-blue-light);font-size:var(--text-sm);font-weight:var(--weight-semibold);text-decoration:none}
.contact-link span{color:var(--brand-teal-light)}
.contact-hero-art{position:relative;min-height:clamp(22rem,36vw,30rem);overflow:hidden;border:1px solid var(--color-border-inverse);background:var(--gradient-dark-luminous)}
.contact-art-grid{position:absolute;inset:0;background:var(--pattern-grid);background-size:2.5rem 2.5rem;opacity:.28;mask-image:radial-gradient(ellipse at center,#000 15%,transparent 78%)}
.contact-ring{position:absolute;left:50%;top:48%;width:65%;aspect-ratio:1;border:1px solid color-mix(in srgb,var(--brand-teal) 36%,transparent);border-radius:50%;transform:translate(-50%,-50%) scaleY(.48) rotate(-28deg)}
.contact-ring-two{width:84%;border-color:color-mix(in srgb,var(--brand-blue-light) 26%,transparent);transform:translate(-50%,-50%) scaleY(.48) rotate(52deg)}
.contact-ring-three{width:52%;border-color:color-mix(in srgb,var(--brand-teal-light) 22%,transparent);transform:translate(-50%,-50%) scaleY(.48) rotate(80deg)}
.contact-art-core{position:absolute;left:50%;top:48%;width:9rem;aspect-ratio:1;display:grid;place-content:center;justify-items:center;border:1px solid var(--color-border-inverse-strong);border-radius:50%;background:var(--color-surface-night-raised);box-shadow:0 0 4rem color-mix(in srgb,var(--brand-blue) 20%,transparent);transform:translate(-50%,-50%)}
.contact-art-core small,.contact-art-core strong{font-family:var(--font-mono);letter-spacing:.1em}
.contact-art-core small{color:var(--color-text-inverse-subtle);font-size:.5rem}
.contact-art-core strong{margin-top:.45rem;color:var(--color-text-inverse);font-size:.8rem}
.contact-art-core i{width:2rem;height:1px;margin-top:.7rem;background:var(--gradient-brand)}
.contact-art-label{position:absolute;padding:.5rem .65rem;border:1px solid var(--color-border-inverse);background:var(--color-surface-night-raised);color:var(--brand-blue-light);font:500 .55rem var(--font-mono);letter-spacing:.1em}
.contact-label-one{left:6%;top:22%}.contact-label-two{right:6%;top:28%}.contact-label-three{left:28%;bottom:17%}
.contact-art-caption{position:absolute;left:1.2rem;bottom:1.1rem;color:var(--color-text-inverse-subtle);font:500 .53rem var(--font-mono);letter-spacing:.12em}
.contact-section{padding:clamp(4.5rem,8vw,7.5rem) 0;border-top:1px solid var(--color-border-inverse)}
.contact-section-alt{background:var(--color-surface-night-raised)}
.contact-section-heading{align-items:end}
.contact-section-heading>p,.contact-conversation>div:first-child>p:not(.contact-eyebrow){max-width:38rem;margin:0;color:var(--color-text-inverse-muted);line-height:1.85}
.contact-paths{margin-top:3rem;border-top:1px solid var(--color-border-inverse)}
.contact-paths article{display:grid;grid-template-columns:3rem 1fr 1.5rem;gap:1.5rem;align-items:center;padding:1.45rem .2rem;border-bottom:1px solid var(--color-border-inverse)}
.contact-paths article>span{color:var(--brand-teal-light);font:500 .6rem var(--font-mono);letter-spacing:.1em}
.contact-paths h3{margin:0;color:var(--color-text-inverse);font-size:1.2rem}
.contact-paths p{margin:.4rem 0 0;color:var(--color-text-inverse-muted);font-size:.88rem;line-height:1.7}
.contact-paths article>b{color:var(--brand-teal-light);font-weight:400}
.contact-opportunities{display:grid;grid-template-columns:9rem 1fr auto;gap:1.5rem;align-items:center;margin-top:3rem;padding:1.5rem;border:1px solid var(--color-border-inverse);background:linear-gradient(105deg,color-mix(in srgb,var(--brand-blue) 10%,var(--color-surface-night-raised)),var(--color-surface-night-raised))}
.contact-opportunities>span,.contact-channel>span,.contact-channel>small{color:var(--brand-teal-light);font:500 .55rem var(--font-mono);letter-spacing:.12em}
.contact-opportunities strong{color:var(--color-text-inverse);font-size:1rem}
.contact-opportunities p{margin:.4rem 0 0;color:var(--color-text-inverse-muted);font-size:.83rem;line-height:1.7}
.contact-opportunities>a{color:var(--brand-blue-light);font-size:.8rem;font-weight:var(--weight-semibold);text-decoration:none;white-space:nowrap}
.contact-opportunities>a span{color:var(--brand-teal-light)}
.contact-conversation{align-items:start}
.contact-conversation>div:first-child>p:not(.contact-eyebrow){margin-top:1.2rem}
.contact-channel{padding:clamp(1.5rem,3vw,2.5rem);border:1px solid var(--color-border-inverse);background:var(--gradient-dark-luminous)}
.contact-channel strong{display:block;margin:1.3rem 0 .8rem;color:var(--color-text-inverse);font-size:clamp(1.4rem,2.4vw,2rem)}
.contact-channel p{color:var(--color-text-inverse-muted);font-size:.9rem;line-height:1.8}
.contact-channel>small{display:block;margin-top:1.6rem;color:var(--color-text-inverse-subtle)}
.contact-next{padding:clamp(4rem,7vw,6rem) 0;border-top:1px solid var(--color-border-inverse);background:var(--gradient-hero-approved)}
.contact-next h2{font-size:clamp(2.5rem,4.5vw,4.4rem)}
.contact-next-links{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
.contact-next-links a{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid var(--color-border-inverse);color:var(--color-text-inverse);font-size:.82rem;text-decoration:none;transition:border-color var(--transition-interactive),background var(--transition-interactive)}
.contact-next-links a:hover{border-color:var(--brand-teal);background:color-mix(in srgb,var(--brand-teal) 7%,transparent)}
.contact-next-links a span{color:var(--brand-teal-light)}
@media(max-width:800px){.contact-hero-grid,.contact-section-heading,.contact-conversation,.contact-next-grid{grid-template-columns:1fr;gap:2rem}.contact-hero-art{min-height:23rem}.contact-opportunities{grid-template-columns:1fr}.contact-opportunities>a{justify-self:start}}
@media(max-width:560px){.contact-wrap{width:calc(100% - 2rem)}.contact-experience h1{font-size:clamp(2.6rem,11vw,3.8rem)}.contact-experience h2{font-size:clamp(2.25rem,9.5vw,3.3rem)}.contact-hero-art{min-height:19rem}.contact-art-core{width:7rem}.contact-art-label{font-size:.45rem;padding:.4rem .45rem}.contact-paths article{grid-template-columns:2rem 1fr 1rem;gap:.8rem}.contact-next-links{grid-template-columns:1fr}.contact-section{padding:4.5rem 0}}
@media(prefers-reduced-motion:reduce){.contact-experience *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>