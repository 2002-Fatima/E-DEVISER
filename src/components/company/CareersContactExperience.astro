---
const paths = [
  ['A problem worth solving', 'Bring us a difficult problem that deserves curiosity, depth, and determination.'],
  ['A collaboration to explore', 'Work with us to bring the right people and capabilities together.'],
  ['A willingness to build', 'If you move between ideas and execution, we want to hear what you could contribute.'],
];
---

<main class="contact-experience">
  <section class="contact-hero"><div class="contact-wrap">
    <p class="contact-eyebrow">E DEVİSER / CAREERS &amp; CONTACT</p>
    <div class="contact-hero-grid"><h1>Good work starts<br />with a <em>conversation.</em></h1><div class="contact-hero-aside"><p>We are building E Deviser around important problems, thoughtful people, and the determination to turn ideas into meaningful work.</p><a class="contact-link" href="#contact">Start a conversation <span aria-hidden="true">↓</span></a></div></div>
    <div class="contact-hero-foot"><span>OPEN TO</span><p>Good questions <i></i> Thoughtful people <i></i> Meaningful work</p></div>
  </div></section>

  <section class="contact-section" id="careers"><div class="contact-wrap">
    <div class="contact-section-heading"><div><p class="contact-eyebrow">CAREERS</p><h2>Curious enough to question.<br /><em>Practical enough to build.</em></h2></div><p>We value people who challenge assumptions, get close to the details, and stay open to changing their minds when the evidence tells them to. We look for people who ask not only what is possible, but what is worth doing.</p></div>
    <div class="contact-paths">{paths.map((path) => <article><h3>{path[0]}</h3><p>{path[1]}</p><span aria-hidden="true">↗</span></article>)}</div>
    <div class="contact-opportunities"><span>OPEN POSITIONS</span><div><strong>We publish roles when they are real.</strong><p>There are no confirmed vacancies in the supplied company content. Opportunities will appear here when roles and application details are approved.</p></div></div>
  </div></section>

  <section class="contact-section contact-section-contact" id="contact"><div class="contact-wrap contact-conversation">
    <div><p class="contact-eyebrow">CONTACT</p><h2>Have something<br /><em>worth exploring?</em></h2></div>
    <div class="contact-message"><p>Whether you have a problem to solve, an idea to discuss, or want to learn more about E Deviser, the starting point is a thoughtful conversation.</p><div class="contact-channel"><span>LET'S TALK</span><strong>Talk to E Deviser.</strong><small>Public contact details are awaiting confirmation.</small></div></div>
  </div></section>

  <section class="contact-next"><div class="contact-wrap contact-next-grid"><div><p class="contact-eyebrow">CONTINUE EXPLORING</p><h2>Get to know<br /><em>our work.</em></h2></div><div class="contact-next-links"><a href="/company/">Company overview <span aria-hidden="true">↗</span></a><a href="/company/team/">Meet the team <span aria-hidden="true">↗</span></a><a href="/what-we-build/">What We Build <span aria-hidden="true">↗</span></a><a href="/our-work/">Our Work <span aria-hidden="true">↗</span></a></div></div></section>
</main>

<style>
.contact-experience{background:var(--color-surface-raised);color:var(--color-text);overflow:hidden}.contact-experience *{box-sizing:border-box}.contact-wrap{width:min(var(--container-wide),calc(100% - 2*var(--gutter)));margin-inline:auto}.contact-eyebrow{margin:0 0 1.25rem;color:var(--primary-700);font:600 .68rem/1.5 var(--font-body);letter-spacing:.12em}
.contact-hero{padding:clamp(5rem,10vw,9rem) 0 2.2rem}.contact-hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,8vw,8rem);align-items:end}.contact-experience h1,.contact-experience h2{margin:0;color:var(--color-text);font-family:var(--font-display);font-weight:700;letter-spacing:-.06em;line-height:1.03;text-wrap:balance}.contact-experience h1{font-size:clamp(3.3rem,7vw,7rem)}.contact-experience h2{font-size:clamp(2.5rem,4.8vw,4.7rem)}.contact-experience em{color:var(--brand-blue);font-style:normal}.contact-hero-aside{max-width:28rem;padding-bottom:.5rem}.contact-hero-aside>p,.contact-section-heading>p,.contact-message>p{color:var(--color-text-muted);font-size:var(--text-body-large);line-height:1.8}.contact-link{display:inline-flex;gap:.8rem;margin-top:1.2rem;color:var(--primary-700);font-size:var(--text-sm);font-weight:600;text-decoration:none}.contact-link span{color:var(--brand-teal)}.contact-hero-foot{display:flex;justify-content:space-between;gap:2rem;margin-top:clamp(4rem,8vw,7rem);padding:1.15rem 0;border-block:1px solid var(--color-border)}.contact-hero-foot span,.contact-hero-foot p{margin:0;color:var(--color-text-subtle);font:500 .62rem var(--font-mono);letter-spacing:.1em}.contact-hero-foot p{display:flex;gap:1rem;color:var(--primary-800)}.contact-hero-foot i{width:1.8rem;height:1px;align-self:center;background:var(--brand-teal)}
.contact-section{padding:clamp(4.5rem,8vw,7.5rem) 0;border-top:1px solid var(--color-border-subtle)}.contact-section-heading{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,8vw,8rem);align-items:end}.contact-section-heading>p{max-width:38rem;margin:0}.contact-paths{margin-top:3.5rem;border-top:1px solid var(--color-border)}.contact-paths article{display:grid;grid-template-columns:minmax(16rem,.8fr) 1fr 1.5rem;gap:2rem;align-items:center;padding:1.5rem .1rem;border-bottom:1px solid var(--color-border)}.contact-paths h3{margin:0;color:var(--color-text);font-size:clamp(1.1rem,1.8vw,1.4rem);font-weight:600;letter-spacing:-.025em}.contact-paths p{max-width:38rem;margin:0;color:var(--color-text-muted);font-size:.92rem;line-height:1.75}.contact-paths article>span{color:var(--brand-teal)}
.contact-opportunities{display:grid;grid-template-columns:12rem 1fr;gap:2rem;margin-top:3rem;padding:1.4rem 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}.contact-opportunities>span,.contact-channel>span{color:var(--primary-700);font:500 .6rem var(--font-mono);letter-spacing:.12em}.contact-opportunities strong{color:var(--color-text);font-size:1rem}.contact-opportunities p{max-width:42rem;margin:.5rem 0 0;color:var(--color-text-muted);font-size:.88rem;line-height:1.75}
.contact-section-contact{background:var(--color-surface-subtle)}.contact-conversation{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:start}.contact-message>p{max-width:38rem;margin:0}.contact-channel{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--color-border)}.contact-channel strong{display:block;margin:.8rem 0;color:var(--color-text);font:600 clamp(1.4rem,2.4vw,2rem) var(--font-display);letter-spacing:-.03em}.contact-channel small{color:var(--color-text-subtle);font-size:.82rem}
.contact-next{padding:clamp(4rem,7vw,6rem) 0;border-top:1px solid var(--color-border)}.contact-next-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:end}.contact-next-links{display:grid;grid-template-columns:1fr 1fr;gap:0 1.5rem}.contact-next-links a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-border);color:var(--color-text);font-size:.88rem;text-decoration:none;transition:color var(--transition-interactive)}.contact-next-links a:hover{color:var(--primary-700)}.contact-next-links a span{color:var(--brand-teal)}
@media(max-width:800px){.contact-hero-grid,.contact-section-heading,.contact-conversation,.contact-next-grid{grid-template-columns:1fr;gap:2rem}.contact-hero-aside{max-width:40rem}}
@media(max-width:560px){.contact-wrap{width:calc(100% - 2rem)}.contact-hero{padding-top:4rem}.contact-experience h1{font-size:clamp(2.8rem,13vw,4.5rem)}.contact-experience h2{font-size:clamp(2.3rem,10vw,3.5rem)}.contact-hero-foot{flex-direction:column;gap:.8rem;margin-top:3rem}.contact-hero-foot p{gap:.6rem;font-size:.52rem}.contact-paths article{grid-template-columns:1fr 1.5rem;gap:.5rem}.contact-paths p{grid-column:1}.contact-paths article>span{grid-column:2;grid-row:1/3}.contact-opportunities{grid-template-columns:1fr;gap:.8rem}.contact-next-links{grid-template-columns:1fr}.contact-section{padding:4.25rem 0}}
@media(prefers-reduced-motion:reduce){.contact-experience *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
