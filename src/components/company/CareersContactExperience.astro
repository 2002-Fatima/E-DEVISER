---
import '../../styles/components/company.css';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import FormFeedback from '../ui/FormFeedback.astro';
import Link from '../ui/Link.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import Select from '../ui/Select.astro';
import TextInput from '../ui/TextInput.astro';
import Textarea from '../ui/Textarea.astro';
import { site } from '../../content/site';

const paths = [
  ['A problem worth solving','Bring us a difficult problem that deserves curiosity, depth, and determination.'],
  ['A collaboration to explore','Work with us to bring the right people and capabilities together.'],
  ['A willingness to build','If you move between ideas and execution, we want to hear what you could contribute.'],
];
const contactEmail = site.contactEmail.trim();
const contactFormEndpoint = site.contactFormEndpoint.trim();
const hasContactChannel = Boolean(contactEmail || contactFormEndpoint);
const interestOptions = paths.map((path, index) => ({
  label: path[0],
  value: ['problem', 'collaboration', 'building'][index],
}));
---

<div class="company-careers">
  <SectionWrapper background="light" class="company-careers-hero">
    <section aria-labelledby="company-careers-title">
      <Container width="wide" class="company-careers-hero-grid">
        <div>
          <p class="eyebrow">CAREERS &amp; CONTACT</p>
          <h1 id="company-careers-title">Good work starts<br/>with a <em>conversation.</em></h1>
          <p class="company-lead">E Deviser exists to work on difficult problems with people who care about making meaningful progress. If that sounds like the work you want to be part of, let’s start a conversation.</p>
        </div>
        <div class="company-contact-art" aria-hidden="true">
          <span>OPEN CHANNEL</span>
          <strong>Let’s<br/><em>connect.</em></strong>
          <i>↗</i>
          <small>E DEVISER / 01</small>
        </div>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="light" class="company-section">
    <section aria-labelledby="company-careers-start-title">
      <Container width="wide">
        <div class="company-split company-careers-intro">
          <SectionHeading
            eyebrow="WHAT BRINGS YOU HERE?"
            title="Start with what matters."
            id="company-careers-start-title"
          />
          <p class="company-copy">We begin with the problem, understand what makes it difficult, and explore what it would take to move it forward. The best conversations are specific, thoughtful, and open to evidence.</p>
        </div>
        <ol class="company-paths">
          {paths.map((path, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{path[0]}</h3>
                <p>{path[1]}</p>
              </div>
            </li>
          ))}
        </ol>
      </Container>
    </section>
  </SectionWrapper>

  <SectionWrapper background="light" class="company-section company-section--soft">
    <section aria-labelledby="company-careers-principles-title">
      <Container width="wide" class="company-split">
        <SectionHeading
          eyebrow="CAREERS"
          title="Curious enough to question. Practical enough to build."
          id="company-careers-principles-title"
        />
        <div class="company-copy">
          <p>We value people who challenge assumptions, get close to the details, and stay open to changing their minds when the evidence tells them to. We look for people who do not just ask what is possible, but what is worth doing.</p>
          <Link href="/company/team/">Meet the team ↗</Link>
        </div>
      </Container>
    </section>
  </SectionWrapper>

  {hasContactChannel && (
    <SectionWrapper background="light" id="contact" class="company-section company-contact-section">
      <section aria-labelledby="company-contact-title">
        <Container width="wide">
          <Card as="div" variant="light" class="company-contact-card">
            <div class="company-contact-copy">
              <SectionHeading
                eyebrow="START A CONVERSATION"
                title="Tell us what you’re thinking."
                id="company-contact-title"
              />
              {contactEmail && (
                <p class="company-contact-fallback">
                  <Link href={`mailto:${contactEmail}`}>Email E Deviser ↗</Link>
                </p>
              )}
            </div>
            {contactFormEndpoint && (
              <form class="company-contact-form" data-contact-form method="POST" action={contactFormEndpoint}>
                <TextInput name="name" label="Name" autocomplete="name" required />
                <TextInput name="email" label="Email" type="email" autocomplete="email" required />
                <Select
                  name="interest"
                  label="What brings you here?"
                  options={interestOptions}
                  placeholder="Select a topic"
                  required
                />
                <Textarea name="message" label="Message" rows={5} required />
                <Button type="submit" label="Send message" variant="primary" />
                <div class="company-contact-feedback">
                  <div data-contact-success hidden>
                    <FormFeedback tone="success">Your message has been sent.</FormFeedback>
                  </div>
                  <div data-contact-error hidden>
                    <FormFeedback tone="error">
                      We couldn’t send your message. Please try again{contactEmail ? ' or email E Deviser directly.' : '.'}
                    </FormFeedback>
                  </div>
                </div>
              </form>
            )}
          </Card>
        </Container>
      </section>
    </SectionWrapper>
  )}
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const feedbackSuccess = form.querySelector<HTMLElement>('[data-contact-success]');
    const feedbackError = form.querySelector<HTMLElement>('[data-contact-error]');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const controller = new AbortController();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      if (feedbackSuccess) feedbackSuccess.hidden = true;
      if (feedbackError) feedbackError.hidden = true;
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Contact form submission failed');
        if (feedbackSuccess) feedbackSuccess.hidden = false;
        form.reset();
      } catch {
        if (feedbackError) feedbackError.hidden = false;
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    }, { signal: controller.signal });

    const cleanup = () => {
      controller.abort();
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
