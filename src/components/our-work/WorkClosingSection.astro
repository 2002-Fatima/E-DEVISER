---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="dark" class="our-work-section our-work-closing-section">
  <section class="container container-wide our-work-closing" aria-labelledby="work-closing-title">
    <p class="eyebrow">THE WORK CONTINUES</p>
    <h2 id="work-closing-title">The next meaningful thing is built together.</h2>
    <p>Have a problem worth working on, an idea to test, or a partnership to explore?</p>
    <a class="our-work-closing-link" href="/company/careers-contact/">Start a conversation <span aria-hidden="true">↗</span></a>
  </section>
</SectionWrapper>
