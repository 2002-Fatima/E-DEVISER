---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Link from '../ui/Link.astro';
---

<SectionWrapper background="luminous" class="our-work-section our-work-closing-section">
  <section aria-labelledby="work-closing-title">
    <Container width="wide" class="our-work-closing">
    <div class="our-work-closing-visual" aria-hidden="true">
      <span class="our-work-closing-orbit our-work-closing-orbit--outer"></span>
      <span class="our-work-closing-orbit our-work-closing-orbit--middle"></span>
      <span class="our-work-closing-orbit our-work-closing-orbit--inner"></span>
      <span class="our-work-closing-core"></span>
      <span class="our-work-closing-axis"></span>
    </div>
    <div class="our-work-closing-copy">
      <SectionHeading
        id="work-closing-title"
        class="our-work-closing-heading"
        eyebrow="THE WORK CONTINUES"
        title="The next meaningful thing starts with a problem worth solving."
        description="Bring us the question, the challenge, or the ambition. We’ll work with you to understand what it takes to move it forward."
      />
      <Link href="/company/careers-contact/" class="our-work-closing-link">Start a conversation <span aria-hidden="true">↗</span></Link>
    </div>
    </Container>
  </section>
</SectionWrapper>
