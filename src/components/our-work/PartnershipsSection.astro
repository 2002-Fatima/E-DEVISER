---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="atmosphere" class="our-work-section">
  <section id="partnerships" class="container container-wide content-section our-work-content our-work-content--partnerships" aria-labelledby="partnerships-title">
    <header class="our-work-section-heading our-work-section-heading--inverse">
      <div>
        <p class="eyebrow">PARTNERSHIPS</p>
        <h2 id="partnerships-title">Progress is built together.</h2>
      </div>
      <p>Relationships across institutions, industry, and the wider ecosystem help ideas travel further. These moments document conversations and engagements—not just logos on a page.</p>
    </header>
    <div class="our-work-partnerships-gallery our-work-bordered-grid">
      <figure class="our-work-image-card our-work-partnership-image"><img src="/media/baykar-conversation.webp" alt="Baykar conversation" loading="lazy" decoding="async" /><figcaption class="our-work-image-caption"><span>Baykar conversation</span><small>Industry engagement</small></figcaption></figure>
      <figure class="our-work-image-card our-work-partnership-image"><img src="/media/investor-group-nicat.webp" alt="NICAT investor group" loading="lazy" decoding="async" /><figcaption class="our-work-image-caption"><span>NICAT investor group</span><small>Ecosystem engagement</small></figcaption></figure>
      <figure class="our-work-image-card our-work-partnership-image"><img src="/media/nutech-leadership.webp" alt="NUtech leadership engagement" loading="lazy" decoding="async" /><figcaption class="our-work-image-caption"><span>NUtech leadership</span><small>Institutional dialogue</small></figcaption></figure>
      <figure class="our-work-image-card our-work-partnership-image"><img src="/media/prime-ministers-house.webp" alt="Engagement at the Prime Minister's House" loading="lazy" decoding="async" /><figcaption class="our-work-image-caption"><span>Prime Minister's House</span><small>Public-sector engagement</small></figcaption></figure>
    </div>
  </section>
</SectionWrapper>
