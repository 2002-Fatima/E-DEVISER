---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="atmosphere" class="our-work-section">
  <section id="recognition" class="container container-wide our-work-content" aria-labelledby="recognition-title">
    <header class="our-work-section-heading our-work-section-heading--inverse">
      <div>
        <p class="eyebrow">RECOGNITION &amp; FEATURES</p>
        <h2 id="recognition-title">A record beyond our own channels.</h2>
      </div>
      <p>Selected event coverage and published materials connected to our work. We keep this section evidence-led: the material is shown as it is, without turning visibility into inflated claims.</p>
    </header>
    <div class="our-work-recognition-grid">
      <figure class="our-work-recognition-item">
        <div class="our-work-recognition-media"><img src="/media/dfdi-2025.webp" width="960" height="869" alt="DFDI 2025 publication material" loading="lazy" decoding="async" /></div>
        <figcaption><span>DFDI 2025</span><small>Published material</small></figcaption>
      </figure>
      <figure class="our-work-recognition-item">
        <div class="our-work-recognition-media"><img src="/media/the-patriot-summit-series.webp" width="1400" height="1332" alt="The Patriot Summit Series publication" loading="lazy" decoding="async" /></div>
        <figcaption><span>The Patriot Summit Series</span><small>Event feature</small></figcaption>
      </figure>
      <figure class="our-work-recognition-item">
        <div class="our-work-recognition-media"><img src="/media/edtech-forum-certificate.webp" alt="EdTech forum certificate" loading="lazy" decoding="async" /></div>
        <figcaption><span>EdTech Forum</span><small>Certificate</small></figcaption>
      </figure>
    </div>
  </section>
</SectionWrapper>
