---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="light" class="our-work-section">
  <section id="archive" class="container container-wide our-work-content" aria-labelledby="archive-title">
    <header class="our-work-section-heading">
      <div>
        <p class="eyebrow">ARCHIVE</p>
        <h2 id="archive-title">The work leaves a trail.</h2>
      </div>
      <p>A record of selected materials, event documentation, and moments from the field—bringing earlier work into view as part of the wider story.</p>
    </header>
    <div class="our-work-archive-list">
      <a href="/media/dfdi-2025.webp" target="_blank" rel="noreferrer" class="our-work-archive-row"><span class="our-work-archive-date">2025</span><span class="our-work-archive-name">DFDI 2025</span><span class="our-work-archive-kind">Publication material</span><span class="our-work-archive-arrow" aria-hidden="true">↗</span></a>
      <a href="/media/the-patriot-summit-series.webp" target="_blank" rel="noreferrer" class="our-work-archive-row"><span class="our-work-archive-date">EVENT</span><span class="our-work-archive-name">The Patriot Summit Series</span><span class="our-work-archive-kind">Event feature</span><span class="our-work-archive-arrow" aria-hidden="true">↗</span></a>
      <a href="/media/classroom-walkthrough-720p.mp4" target="_blank" rel="noreferrer" class="our-work-archive-row"><span class="our-work-archive-date">FIELD</span><span class="our-work-archive-name">Classroom walkthrough</span><span class="our-work-archive-kind">Field video</span><span class="our-work-archive-arrow" aria-hidden="true">↗</span></a>
      <a href="/media/library-excerpt-720p.mp4" target="_blank" rel="noreferrer" class="our-work-archive-row"><span class="our-work-archive-date">FIELD</span><span class="our-work-archive-name">Library excerpt</span><span class="our-work-archive-kind">Field video</span><span class="our-work-archive-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</SectionWrapper>
