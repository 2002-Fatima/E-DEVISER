---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="light" class="our-work-section">
  <section id="forums-events" class="container container-wide content-section our-work-content" aria-labelledby="forums-events-title">
    <header class="our-work-section-heading">
      <div>
        <p class="eyebrow">FORUMS &amp; EVENTS</p>
        <h2 id="forums-events-title">Conversations that build the future.</h2>
      </div>
      <p>Forums, summits, and events that spark dialogue, share knowledge, and shape the ecosystem.</p>
    </header>

    <article class="our-work-forum-feature">
      <div class="our-work-forum-copy">
        <p class="eyebrow">FEATURED FORUM</p>
        <p class="our-work-forum-kicker">AI × FUTURE FORUM</p>
        <h3>Shaping what&apos;s next.</h3>
        <p>Bringing together global leaders, educators, researchers, and innovators to explore how AI is redefining the future of learning and society.</p>
        <div class="our-work-topic-list" aria-label="Forum themes">
          <span>Future of learning</span>
          <span>AI &amp; society</span>
          <span>Global perspectives</span>
        </div>
      </div>
      <figure class="our-work-forum-image">
        <img src="/media/the-patriot-ai-future-summit.webp" alt="The Patriot AI Future Summit" loading="lazy" decoding="async" />
      </figure>
    </article>

    <div class="our-work-image-grid our-work-image-grid--three our-work-image-grid--compact">
      <figure class="our-work-image-card"><img src="/media/the-patriot-edtech-forum.webp" alt="The Patriot EdTech Forum" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card"><img src="/media/daily-pakistan-edtech-forum.webp" alt="Daily Pakistan EdTech Forum coverage" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card"><img src="/media/edtech-forum-panel.webp" alt="EdTech forum panel" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card"><img src="/media/edtech-forum-guest.webp" alt="EdTech forum guest" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card"><img src="/media/edtech-forum-group.webp" alt="EdTech forum group" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card"><img src="/media/the-patriot-summit-series.webp" alt="The Patriot Summit Series" loading="lazy" decoding="async" /></figure>
    </div>
  </section>
</SectionWrapper>
