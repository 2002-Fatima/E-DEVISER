---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="light" class="our-work-section">
  <section id="news-features" class="container container-wide content-section our-work-content" aria-labelledby="news-title">
    <header class="our-work-section-heading">
      <div>
        <p class="eyebrow">NEWS / FEATURES</p>
        <h2 id="news-title">Updates and commentary</h2>
      </div>
    </header>
    <div class="our-work-image-grid our-work-image-grid--three">
      <figure class="our-work-image-card our-work-image-card--document"><img src="/media/dfdi-2025.webp" alt="DFDI 2025" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card our-work-image-card--document"><img src="/media/the-patriot-ai-future-summit.webp" alt="AI Future Summit coverage" loading="lazy" decoding="async" /></figure>
      <figure class="our-work-image-card our-work-image-card--document"><img src="/media/daily-pakistan-edtech-forum.webp" alt="Daily Pakistan EdTech Forum coverage" loading="lazy" decoding="async" /></figure>
    </div>
  </section>
</SectionWrapper>
