---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper>
  <section id="news-features" class="container content-section">
    <div class="section-heading">
      <p class="eyebrow">NEWS / FEATURES</p>
      <h2>Updates and commentary</h2>
    </div>
    <div class="empty-state">
      <p>No unverified publications, feature stories, or press references are included here.</p>
    </div>
  </section>
</SectionWrapper>
