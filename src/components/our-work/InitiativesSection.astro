---
import SectionWrapper from '../ui/SectionWrapper.astro';
---

<SectionWrapper background="light" class="our-work-section">
  <section id="initiatives" class="container container-wide content-section our-work-content our-work-content--initiatives" aria-labelledby="initiatives-title">
    <header class="our-work-section-heading">
      <div>
        <p class="eyebrow">INITIATIVES</p>
        <h2 id="initiatives-title">Work we choose to move forward.</h2>
      </div>
      <p>Programs and practical environments shaped around real needs. These are the spaces where ideas become work that can be experienced, questioned, and improved.</p>
    </header>
    <div class="our-work-image-grid our-work-image-grid--initiatives our-work-initiatives-gallery our-work-bordered-grid">
      <figure class="our-work-image-card">
        <img src="/media/classroom-poster.webp" alt="Classroom learning environment" loading="lazy" decoding="async" />
        <figcaption class="our-work-image-caption"><span>Learning environments</span><small>Initiatives</small></figcaption>
      </figure>
      <figure class="our-work-image-card">
        <img src="/media/library-poster.webp" alt="Library learning environment" loading="lazy" decoding="async" />
        <figcaption class="our-work-image-caption"><span>Spaces for discovery</span><small>Learning spaces</small></figcaption>
      </figure>
      <figure class="our-work-image-card">
        <img src="/media/classroom-entrance.webp" alt="Classroom entrance and learning space" loading="lazy" decoding="async" />
        <figcaption class="our-work-image-caption"><span>Designed for participation</span><small>On the ground</small></figcaption>
      </figure>
    </div>
  </section>
</SectionWrapper>
